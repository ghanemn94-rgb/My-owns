{
  "name": "@hub/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "push:test": "drizzle-kit push --config drizzle.config.ts --force && tsx src/cli/post-migrate.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "reset:dev": "tsx src/cli/reset-dev.ts",
    "docs": "tsx src/cli/data-dictionary.ts"
  },
  "dependencies": {
    "@hub/domain": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/pg": "8.23.1",
    "@types/node": "22.20.4"
  }
}
