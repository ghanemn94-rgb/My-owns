# =====================================================================================================================
# Transformation Hub — Docker Compose environment for DEVELOPMENT / EVALUATION ONLY (not production, not HA).
# Copy to deploy/compose/.env and replace every CHANGE_ME value locally — or run `bash scripts/ops/compose-env-init.sh`,
# which does both with random local-only values. Never commit .env (it is gitignored).
# Production configuration is delivered through the Helm chart with secret REFERENCES (docs/deployment/secrets.md).
# =====================================================================================================================

# --- Images (dev builds from source; pin mirrored images by digest outside dev) ----------------------------------------
HUB_NODE_BASE=node:22.22.2-bookworm-slim
HUB_POSTGRES_IMAGE=postgres:16.10-bookworm
HUB_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
HUB_API_IMAGE=transformation-hub/api:dev
HUB_WEB_IMAGE=transformation-hub/web:dev

# --- PostgreSQL (local container only) ----------------------------------------------------------------------------------
# Superuser of the local container (used only by the init script that creates hub_owner/hub_app).
POSTGRES_PASSWORD=CHANGE_ME_local_superuser_password
HUB_DB_NAME=hub
# Owner role: owns the schema, runs migrations (migrate service only). Runtime role: NOBYPASSRLS, DML only.
HUB_OWNER_DB_PASSWORD=CHANGE_ME_local_owner_password
HUB_APP_DB_PASSWORD=CHANGE_ME_local_runtime_password

# --- Application -------------------------------------------------------------------------------------------------------
# demo  = synthetic "Demo" sandbox with the demo-user picker (development/evaluation only; refused in production)
# standard = no demo login; requires OIDC below
HUB_MODE=demo
NODE_ENV=development
HUB_ORG_SLUG=mobily
HUB_LOG_LEVEL=info
HUB_PRIVATE_MODE=true
# Comma-separated host names the application may call (in-app egress guard). Empty = no outbound calls.
HUB_EGRESS_ALLOWLIST=
HUB_AI_ALLOW_MOCK=true

# --- OIDC (only for HUB_MODE=standard; values come from your IdP test tenant) ------------------------------------------
HUB_OIDC_ISSUER=
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=
HUB_OIDC_REDIRECT_URI=

# --- Optional MinIO profile (docker compose --profile s3 up) -----------------------------------------------------------
# S3 variable names below are PROPOSED for the S3-compatible storage adapter (not yet read by config.ts at this commit).
MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_admin_password
HUB_S3_BUCKET=hub-objects

# --- Published ports (bound to 127.0.0.1 only) -------------------------------------------------------------------------
HUB_WEB_PORT=3000
HUB_API_PORT=4000
