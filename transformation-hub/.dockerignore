# Build context = transformation-hub/ (see apps/api/Dockerfile, apps/web/Dockerfile).
# Keep the context small and free of local state, build output and anything that could contain secrets.
.git
.github
.claude
.dev
.data
docs
scripts
deploy/compose
deploy/helm
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/*.tsbuildinfo
**/test-results
**/playwright-report
**/*.log
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.npmrc.local
