{
  "name": "@mth/web",
  "version": "0.1.0",
  "private": true,
  "description": "React single-page web app (ADR-0009): bilingual ar/en shell, design tokens, locally bundled fonts",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.e2e.json",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "cd ../.. && apps/web/e2e/support/with-stack.sh npx playwright test apps/web/e2e --workers=1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.2.6",
    "@fontsource/ibm-plex-sans-arabic": "5.2.6",
    "@mth/design-tokens": "workspace:*",
    "@mth/shared": "workspace:*",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-table": "8.21.3",
    "decimal.js": "10.6.0",
    "i18next": "26.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.62.0",
    "react-i18next": "17.0.15",
    "react-router": "7.9.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "vite": "7.1.11"
  }
}
