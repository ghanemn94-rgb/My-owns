{
  "name": "@mth/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker: outbox relay, pg-boss job handlers, scheduler (ADR-0008)",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "@mth/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --conditions=@mth/source --watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@mth/config": "workspace:*",
    "@mth/db": "workspace:*",
    "@mth/reporting": "workspace:*",
    "@mth/shared": "workspace:*",
    "kysely": "0.28.18",
    "nodemailer": "10.2.1",
    "pg": "8.16.3",
    "pg-boss": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}
