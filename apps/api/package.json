{
  "name": "@mth/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API: one Fastify process with explicit modules (ADR-0002, ADR-0007)",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "@mth/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --conditions=@mth/source --watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.2.0",
    "@mth/config": "workspace:*",
    "@mth/db": "workspace:*",
    "@mth/shared": "workspace:*",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.6.0",
    "fastify": "5.6.1",
    "kysely": "0.28.7",
    "openid-client": "6.8.1",
    "pg": "8.16.3",
    "uuid": "13.0.0",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}
