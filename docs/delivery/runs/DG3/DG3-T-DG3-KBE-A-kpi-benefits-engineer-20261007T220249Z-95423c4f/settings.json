{
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "Write|Edit|NotebookEdit|MultiEdit",
    "hooks": [
     {
      "type": "command",
      "command": "if [ -z \"$MTH_GUARD_ROOT\" ]; then echo \"write guard: MTH_GUARD_ROOT is not set (run agents through tools/agents/run-agent.sh)\" >&2; exit 2; fi; g=\"$MTH_GUARD_ROOT/tools/agents/guard-write.mjs\"; if [ -f \"$g\" ]; then node \"$g\" kpi-benefits-engineer; rc=$?; else echo \"write guard missing\" >&2; rc=2; fi; [ \"$rc\" -eq 0 ] || exit 2"
     }
    ]
   }
  ]
 },
 "sandbox": {
  "enabled": true,
  "failIfUnavailable": true,
  "allowUnsandboxedCommands": false,
  "autoAllowBashIfSandboxed": true,
  "enableWeakerNestedSandbox": true,
  "filesystem": {
   "denyWrite": [
    "/home/user/My-owns/.claude",
    "/home/user/My-owns/.git",
    "/home/user/My-owns/.gitattributes",
    "/home/user/My-owns/.github",
    "/home/user/My-owns/.gitignore",
    "/home/user/My-owns/.mcp.json",
    "/home/user/My-owns/CLAUDE.local.md",
    "/home/user/My-owns/CLAUDE.md",
    "/home/user/My-owns/docs/delivery/assignments",
    "/home/user/My-owns/docs/delivery/candidates",
    "/home/user/My-owns/docs/delivery/findings.json",
    "/home/user/My-owns/docs/delivery/gates",
    "/home/user/My-owns/docs/delivery/reviews",
    "/home/user/My-owns/docs/delivery/runs",
    "/home/user/My-owns/docs/delivery/stages.json",
    "/home/user/My-owns/docs/delivery/test-evidence",
    "/home/user/My-owns/docs/source",
    "/home/user/My-owns/tools/agents",
    "/home/user/My-owns/tools/deps",
    "/home/user/My-owns/tools/gates",
    "/home/user/My-owns/tools/source",
    "/home/user/My-owns/trading_agent",
    "/home/user/wt/dg3-kbe-a/.claude",
    "/home/user/wt/dg3-kbe-a/.git",
    "/home/user/wt/dg3-kbe-a/.gitattributes",
    "/home/user/wt/dg3-kbe-a/.github",
    "/home/user/wt/dg3-kbe-a/.gitignore",
    "/home/user/wt/dg3-kbe-a/.mcp.json",
    "/home/user/wt/dg3-kbe-a/CLAUDE.local.md",
