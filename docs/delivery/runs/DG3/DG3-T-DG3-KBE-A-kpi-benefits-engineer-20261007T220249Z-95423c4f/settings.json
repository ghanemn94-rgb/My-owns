    "/home/user/wt/dg3-kbe-a/docs/delivery/assignments",
    "/home/user/wt/dg3-kbe-a/docs/delivery/candidates",
    "/home/user/wt/dg3-kbe-a/docs/delivery/findings.json",
    "/home/user/wt/dg3-kbe-a/docs/delivery/gates",
    "/home/user/wt/dg3-kbe-a/docs/delivery/reviews",
