{
 "schema": "mth-process-sandbox-v1",
 "role": "backend-workflow-engineer",
 "root": "/home/user/My-owns",
 "confined": false,
 "read_only_root": true,
 "private_tmp": [
  "/tmp",
  "/var/tmp"
 ],
 "procfs": "host-bind",
 "run_tmp": "/var/tmp/mth-run.cDJ2NX",
 "writable_areas": [
  "."
 ],
 "read_only_within_writable": [
  ".claude",
  ".git",
  ".gitattributes",
  ".github",
  ".gitignore",
  "CLAUDE.md",
  "docs/delivery/assignments",
  "docs/delivery/candidates",
  "docs/delivery/findings.json",
  "docs/delivery/gates",
  "docs/delivery/reviews",
  "docs/delivery/runs",
  "docs/delivery/stages.json",
  "docs/delivery/test-evidence",
  "docs/source",
  "tools/agents",
  "tools/deps",
  "tools/gates",
  "tools/source",
  "trading_agent"
 ],
 "staged": [],
 "private_sessions": true,
 "cgroup_api": "/sys/fs/cgroup/memory/process_api",
 "capabilities": [
  "CAP_SETFCAP"
 ],
 "no_new_privs": true,
 "unshare": [
  "ipc"
 ],
 "landlock": {
  "scoped": [
   "SIGNAL",
   "ABSTRACT_UNIX_SOCKET"
  ],
  "handled_access_fs": 0,
  "handled_access_net": 0,
  "per_run_domain": true
 },
 "copied_back": [],
 "discarded": []
}
