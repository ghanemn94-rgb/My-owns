{
 "schema": "mth-process-sandbox-v1",
 "role": "release-auditor",
 "root": "/home/user/My-owns",
 "confined": true,
 "read_only_root": true,
 "private_tmp": [
  "/tmp",
  "/var/tmp"
 ],
 "procfs": "host-bind",
 "run_tmp": "/var/tmp/mth-run.2An6W9",
 "writable_areas": [
  "docs/delivery/test-evidence/DG1/audit"
 ],
 "read_only_within_writable": [],
 "staged": [
  {
   "area": "docs/delivery/reviews/DG1",
   "accept": "round-[0-9]+/release\\-auditor\\.[^/]+",
   "replace": false,
   "copied": null
  },
  {
   "area": "docs/delivery/gates",
   "accept": "DG1\\.json",
   "replace": true,
   "copied": null
  }
 ],
 "private_sessions": true,
 "cgroup_api": "/sys/fs/cgroup/memory/process_api",
 "capabilities": [
  "CAP_SETFCAP"
 ],
 "no_new_privs": true,
 "unshare": [
  "ipc"
 ],
 "landlock": {
  "scoped": [
   "SIGNAL",
   "ABSTRACT_UNIX_SOCKET"
  ],
  "handled_access_fs": 0,
  "handled_access_net": 0,
  "per_run_domain": true
 },
 "copied_back": [
  "docs/delivery/reviews/DG1/round-16/release-auditor.json",
  "docs/delivery/gates/DG1.json"
 ],
 "discarded": []
}
