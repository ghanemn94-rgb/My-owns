{
 "schema": "mth-process-sandbox-v1",
 "role": "code-security-reviewer",
 "root": "/home/user/My-owns",
 "confined": true,
 "read_only_root": true,
 "private_tmp": [
  "/tmp",
  "/var/tmp"
 ],
 "procfs": "host-bind",
 "run_tmp": "/var/tmp/mth-run.IA7m2o",
 "writable_areas": [
  "docs/delivery/test-evidence/DG0/code-security"
 ],
 "read_only_within_writable": [],
 "staged": [
  {
   "area": "docs/delivery/reviews/DG0",
   "accept": "round-[0-9]+/code\\-security\\-reviewer\\.[^/]+",
   "replace": false,
   "copied": null
  }
 ],
 "private_sessions": true,
 "cgroup_api": "/sys/fs/cgroup/memory/process_api",
 "capabilities": [
  "CAP_SETFCAP"
 ],
 "no_new_privs": true,
 "unshare": [],
 "copied_back": [
  "docs/delivery/reviews/DG0/round-16/code-security-reviewer.findings.json",
  "docs/delivery/reviews/DG0/round-16/code-security-reviewer.json",
  "docs/delivery/reviews/DG0/round-16/code-security-reviewer.verifications.json"
 ],
 "discarded": [
  "docs/delivery/reviews/DG0/round-16/domain-reviewer.json: removed in the sandbox (kept)"
 ]
}
