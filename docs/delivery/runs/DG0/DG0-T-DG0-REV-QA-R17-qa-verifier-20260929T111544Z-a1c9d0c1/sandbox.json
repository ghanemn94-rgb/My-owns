{
 "schema": "mth-process-sandbox-v1",
 "role": "qa-verifier",
 "root": "/home/user/My-owns",
 "confined": true,
 "read_only_root": true,
 "private_tmp": [
  "/tmp",
  "/var/tmp"
 ],
 "procfs": "host-bind",
 "run_tmp": "/var/tmp/mth-run.67ZgUP",
 "writable_areas": [
  "docs/delivery/test-evidence/DG0/qa",
  "tests/qa",
  "e2e"
 ],
 "read_only_within_writable": [],
 "staged": [
  {
   "area": "docs/delivery/reviews/DG0",
   "accept": "round-[0-9]+/qa\\-verifier\\.[^/]+",
   "replace": false,
   "copied": null
  }
 ],
 "private_sessions": true,
 "cgroup_api": "/sys/fs/cgroup/memory/process_api",
 "capabilities": [
  "CAP_SETFCAP"
 ],
 "no_new_privs": true,
 "unshare": [
  "ipc"
 ],
 "copied_back": [
  "docs/delivery/reviews/DG0/round-17/qa-verifier.findings.json",
  "docs/delivery/reviews/DG0/round-17/qa-verifier.verifications.json"
 ],
 "discarded": []
}
