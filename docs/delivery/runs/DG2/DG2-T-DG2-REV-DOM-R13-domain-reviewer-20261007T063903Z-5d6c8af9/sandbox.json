{
 "schema": "mth-process-sandbox-v1",
 "role": "domain-reviewer",
 "root": "/home/user/My-owns",
 "confined": true,
 "read_only_root": true,
 "private_tmp": [
  "/tmp",
  "/var/tmp"
 ],
 "procfs": "host-bind",
 "run_tmp": "/var/tmp/mth-run.3sKDTK",
 "writable_areas": [
  "docs/delivery/test-evidence/DG2/domain"
 ],
 "read_only_within_writable": [],
 "staged": [
  {
   "area": "docs/delivery/reviews/DG2",
   "accept": "round-[0-9]+/domain\\-reviewer\\.[^/]+",
   "replace": false,
   "copied": null
  }
 ],
 "private_sessions": true,
 "cgroup_api": "/sys/fs/cgroup/memory/process_api",
 "capabilities": [
  "CAP_SETFCAP"
 ],
 "no_new_privs": true,
 "unshare": [
  "ipc"
 ],
 "landlock": {
  "scoped": [
   "SIGNAL",
   "ABSTRACT_UNIX_SOCKET"
  ],
  "handled_access_fs": 0,
  "handled_access_net": 0,
  "per_run_domain": true
 },
 "copied_back": [
  "docs/delivery/reviews/DG2/round-13/domain-reviewer.findings.json",
  "docs/delivery/reviews/DG2/round-13/domain-reviewer.json",
  "docs/delivery/reviews/DG2/round-13/domain-reviewer.md"
 ],
 "discarded": []
}
