{
 "schema": "mth-process-sandbox-v1",
 "role": "transformation-analyst",
 "root": "/home/user/My-owns",
 "confined": true,
 "read_only_root": true,
 "private_tmp": [
  "/tmp",
  "/var/tmp"
 ],
 "procfs": "host-bind",
 "run_tmp": "/var/tmp/mth-run.U1U955",
 "writable_areas": [
  "docs/analysis",
  "docs/delivery/handbacks"
 ],
 "read_only_within_writable": [],
 "staged": [
  {
   "area": "docs/delivery",
   "accept": "requirements\\.csv",
   "replace": true,
   "copied": [
    "requirements.csv"
   ]
  }
 ],
 "private_sessions": true,
 "cgroup_api": "/sys/fs/cgroup/memory/process_api",
 "capabilities": [
  "CAP_SETFCAP"
 ],
 "no_new_privs": true,
 "unshare": [
  "ipc"
 ],
 "landlock": {
  "scoped": [
   "SIGNAL",
   "ABSTRACT_UNIX_SOCKET"
  ],
  "handled_access_fs": 0,
  "handled_access_net": 0,
  "per_run_domain": true
 },
 "copied_back": [
  "docs/delivery/requirements.csv"
 ],
 "discarded": []
}
