const fs=require("fs");
function parse(t){const rows=[];let row=[],f="",q=false;for(let i=0;i<t.length;i++){const c=t[i];if(q){if(c==="\""){if(t[i+1]==="\""){f+="\"";i++}else q=false}else f+=c}else if(c==="\"")q=true;else if(c===","){row.push(f);f=""}else if(c==="\n"){row.push(f);rows.push(row);row=[];f=""}else if(c!=="\r")f+=c}if(f||row.length){row.push(f);rows.push(row)}return rows}
const rows=parse(fs.readFileSync("docs/delivery/requirements.csv","utf8"));const h=rows[0];
const ids=["REQ-DLV-025","REQ-DLV-033","REQ-DLV-042","REQ-S15-002","REQ-S15-005","REQ-S15-006","REQ-S16-001","REQ-S16-002","REQ-S16-003","REQ-S16-004","REQ-S19-004","REQ-S19-006"];
let bad=0;
for(const id of ids){const r=rows.find(r=>r[0]===id);const o=Object.fromEntries(h.map((k,i)=>[k,r[i]]));
 const ev=(o.evidence||"").split(/[;|\s]+/).filter(Boolean);
 const miss=ev.filter(p=>{try{return !fs.statSync(p.split("#")[0]).isFile()}catch{return true}});
 if(o.status!=="IMPLEMENTED"||miss.length)bad++;
 console.log(`${id} final_gate=${o.final_gate} status=${o.status} evidence=${ev.length} missing=${JSON.stringify(miss)}`);}
// all IMPLEMENTED DG1 rows
const dg1=rows.slice(1).filter(r=>r[h.indexOf("final_gate")]==="DG1");
console.log("rows with final_gate=DG1:",dg1.length, dg1.map(r=>r[0]+":"+r[h.indexOf("status")]).join(" "));
for(const id of ["REQ-S19-004","REQ-DLV-033"]){const r=rows.find(r=>r[0]===id);console.log("\n---",id,"\nEVIDENCE:",r[h.indexOf("evidence")],"\nNOTES:",r[h.indexOf("notes")]);}
console.log(bad?`\nRESULT: FAIL (${bad})`:"\nRESULT: PASS all 12 IMPLEMENTED with existing evidence"); process.exit(bad?1:0);
