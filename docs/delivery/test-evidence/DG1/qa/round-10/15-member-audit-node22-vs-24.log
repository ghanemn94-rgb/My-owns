# Member enumeration of the 7 allow-listed built-ins (own + enumerable, one nested level; 'constants' not descended), Node 22 vs Node 24
$ /opt/node22/bin/node enum2.mjs   -> v22.22.2 openssl 3.5.5: 420 entries
$ /opt/nvm/versions/node/v24.21.0/bin/node enum2.mjs -> v24.21.0 openssl 3.5.8: 413 entries
--- enum2.mjs:
const out = [];
for (const m of ["crypto","fs","fs/promises","os","path","url","util"]) {
  const ns = await import("node:" + m); const root = ns.default ?? ns; const seen = new Set();
  const visit = (o, pre, d) => { for (const k of new Set([...Object.keys(o), ...Object.getOwnPropertyNames(o)])) {
    if (seen.has(pre+k)) continue; seen.add(pre+k); let v; try { v = o[k]; } catch { continue; }
    out.push(`${m}.${pre}${k}${typeof v === "function" ? "()" : ""}`);
    if (d < 1 && v && typeof v === "object" && k !== "constants") visit(v, pre + k + ".", d + 1); } };
  visit(root, "", 0);
}
console.log(out.sort().join("\n"));
