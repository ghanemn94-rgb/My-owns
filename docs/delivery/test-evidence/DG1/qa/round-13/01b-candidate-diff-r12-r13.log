-    return statSync(p).isDirectory() ? walk(p) : /\.(ts|tsx)$/.test(name) ? [p] : [];
+    return statSync(p).isDirectory() ? walk(p) : CODE_FILE.test(name) ? [p] : [];
   });
 }
 
