import csv,os,re,sys
ids="REQ-DLV-025 REQ-DLV-033 REQ-DLV-042 REQ-S15-002 REQ-S15-005 REQ-S15-006 REQ-S16-001 REQ-S16-002 REQ-S16-003 REQ-S16-004 REQ-S19-004 REQ-S19-006".split()
rows={r['id'] if 'id' in r else r[list(r)[0]]:r for r in csv.DictReader(open('docs/delivery/requirements.csv'))}
bad=0
for i in ids:
  r=rows.get(i)
  if not r: print(i,"MISSING ROW"); bad+=1; continue
  ev=[p.split('#')[0] for p in re.split(r'[;|\s]+',r.get('evidence','') or '') if p.strip()]
  miss=[p for p in ev if not os.path.isfile(p)]
  if r.get('final_gate')!='DG1' or r.get('status')!='IMPLEMENTED' or miss or not ev: bad+=1
  print(f"{i}: final_gate={r.get('final_gate')} status={r.get('status')} evidence_count={len(ev)} missing={miss}")
print("RESULT:", "PASS" if bad==0 else f"FAIL ({bad})"); sys.exit(1 if bad else 0)
