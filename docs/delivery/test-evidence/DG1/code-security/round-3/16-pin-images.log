EXIT=0

--- CI images job (pin steps):
  images:
    needs: [integration, e2e]
    runs-on: ubuntu-24.04
    env:
      MTH_APP_IMAGE: mth-app:ci-${{ github.sha }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
      - name: pnpm at the packageManager version (real binary on PATH; no install scripts)
        run: npm install --global --ignore-scripts "$(node -p 'require("./package.json").packageManager.split("+")[0]')"
      - name: bubblewrap for the sandboxed installer (ephemeral runner; allow unprivileged user namespaces for bwrap)
        run: |
          sudo apt-get update -q && sudo apt-get install -y -q --no-install-recommends bubblewrap
          if [ -e /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]; then
            sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          fi
      - name: Install (sandboxed, frozen lockfile; BLOCKED without bubblewrap - never an unsandboxed fallback)
        run: deploy/scripts/ci-install-deps.sh
      - name: Deploy tooling self-tests (check-ci-needs negatives incl. status-function and gate-context bypasses; pin-images BLOCKED and --missing paths)
        run: node --test deploy/scripts/tests/check-ci-needs.test.mjs deploy/scripts/tests/pin-images.test.mjs
      - name: CI structure (gated on delivery-gates success; sandboxed installs only; actions pinned by SHA)
        run: node deploy/scripts/check-ci-needs.mjs
      - name: .env.example equals the ENV_VARS catalogue (names only, no values)
        run: node deploy/scripts/generate-env-example.mjs --check
      - name: SBOM and licence inventory match the lockfile
        run: node licenses/generate-sbom.mjs --check
      # F-DG1-108/F-DG1-203, D-049: the committed lock records the TEST-ONLY keycloak image (Compose profile test-idp)
      # as BLOCKED (null digest) because the build environment's egress policy denies quay.io. GitHub-hosted runners
      # reach quay.io, so this step resolves ONLY images still missing a digest, live, and applies the digest to the
      # workspace copy. Where the registry is unreachable it exits 1 (BLOCKED) and the job fails: no digest is ever
      # fabricated and --check never passes on a null digest. The resolved lock is kept in the stack-evidence artifact
      # so IT can review and commit the pin.
      - name: Resolve and pin images still missing a digest (live registry lookup; test-only keycloak)
        run: |
          node deploy/scripts/pin-images.mjs --resolve --missing
          node deploy/scripts/pin-images.mjs --apply
          mkdir -p stack-evidence
          cp deploy/images.lock.json stack-evidence/images.lock.ci-resolved.json
      - name: Container images pinned by digest (deploy/images.lock.json)
        run: node deploy/scripts/pin-images.mjs --check
      - name: Build the application image (non-root; api | worker | migrate)
        run: deploy/scripts/build-image.sh --tag "$MTH_APP_IMAGE"
      - name: Compose clean start, Keycloak test-IdP login smoke, no-egress smoke
        run: deploy/scripts/verify-stack.sh --skip-build --evidence-dir stack-evidence
      - if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2 - same pin as e2e; re-verify
        with:
          name: stack-evidence
          path: stack-evidence/
          retention-days: 14
      # Push only from protected branches, and only when Mobily IT's registry is configured (repository variable
      # MTH_REGISTRY, secrets MTH_REGISTRY_USER / MTH_REGISTRY_PASSWORD). Nothing is pushed to a public registry.
      - name: Push to IT's registry (protected branches only)
        if: github.event_name == 'push' && github.ref_protected && vars.MTH_REGISTRY != ''
        env:
          REGISTRY: ${{ vars.MTH_REGISTRY }}
          REGISTRY_USER: ${{ secrets.MTH_REGISTRY_USER }}
          REGISTRY_PASSWORD: ${{ secrets.MTH_REGISTRY_PASSWORD }}
