#!/bin/bash
# Inside withpg.sh (port 5471): roles/db (trust auth, synthetic), migrate with the ASSEMBLED CLI, start the ASSEMBLED API.
A=postgresql://postgres@127.0.0.1:5471/postgres
psql -q $A -c "CREATE ROLE mth_owner LOGIN; CREATE ROLE mth_app LOGIN;" -c "CREATE DATABASE mth OWNER mth_owner;" -c "GRANT CONNECT ON DATABASE mth TO mth_app;"
cd $TMPDIR/asm-out
echo "--- migrate (assembled packages/db/dist/cli.js)"
DATABASE_OWNER_URL=postgresql://mth_owner@127.0.0.1:5471/mth NODE_ENV=production node packages/db/dist/cli.js migrate 2>&1 | tail -2
COMMON="AUTH_MODE=oidc DATABASE_URL=postgresql://mth_app@127.0.0.1:5471/mth OIDC_ISSUER_URL=https://idp.invalid.example OIDC_CLIENT_ID=c OIDC_CLIENT_SECRET=s LOG_LEVEL=warn"
echo "--- F-DG1-202: start assembled API (NODE_ENV=production, APP_BASE_URL=http://localhost:3171, loopback allowed)"
env $COMMON NODE_ENV=production APP_BASE_URL=http://localhost:3171 PORT=3171 node apps/api/dist/main.js > $TMPDIR/api.log 2>&1 & P=$!
for i in $(seq 1 40); do curl -s -o /dev/null http://127.0.0.1:3171/healthz && break; sleep 0.5; done
echo "GET /healthz -> $(curl -s -w ' [%{http_code}]' http://127.0.0.1:3171/healthz)"
echo "GET /readyz  -> $(curl -s -w ' [%{http_code}]' http://127.0.0.1:3171/readyz)"
echo "GET /api/v1/branding/tokens (design-tokens path; unauthenticated) -> $(curl -s -o /dev/null -w '[%{http_code}]' http://127.0.0.1:3171/api/v1/branding/tokens)"
echo "process alive: $(kill -0 $P 2>/dev/null && echo yes || echo NO)"; kill $P; wait $P 2>/dev/null
echo "--- F-DG1-112: NODE_ENV=production with a NON-loopback http APP_BASE_URL must be refused at startup"
for u in http://mth.example.com http://10.0.0.5:3000 http://localhost.example.com https://mth.example.com; do
  timeout 8 env $COMMON NODE_ENV=production APP_BASE_URL=$u PORT=3172 node apps/api/dist/main.js > $TMPDIR/api112.log 2>&1; rc=$?
  echo "APP_BASE_URL=$u -> exit=$rc  $(grep -ioE 'APP_BASE_URL[^"]{0,140}' $TMPDIR/api112.log | head -1)"
done
echo "--- control: NODE_ENV=development with http://mth.example.com is accepted (exit 124 = still running at timeout)"
timeout 5 env $COMMON NODE_ENV=development APP_BASE_URL=http://mth.example.com PORT=3173 node apps/api/dist/main.js > $TMPDIR/api112d.log 2>&1; echo "exit=$?"
