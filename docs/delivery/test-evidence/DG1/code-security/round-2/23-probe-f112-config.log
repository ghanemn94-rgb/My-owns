for (const u of ["http://app.example.com", "http://localhost.evil.example", "http://LOCALHOST:3000", "http://127.0.0.1:3000", "http://[::1]:3000", "https://app.example.com", "http://10.0.0.5"]) {
  for (const env of ["production", "development"]) {
    try { const c = loadConfig("api", { ...base, NODE_ENV: env, APP_BASE_URL: u }); console.log(env.padEnd(12), u.padEnd(32), "ACCEPTED", c.appBaseUrl?.protocol); }
    catch (e) { console.log(env.padEnd(12), u.padEnd(32), "REFUSED ", String((e as Error).message).replace(/\n/g," | ").slice(0,160)); }
  }
}
