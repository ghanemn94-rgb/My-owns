240:  chk R7 "evidence" "{\"verified\": ${entries:-null}, \"mismatches\": 0, \"retentionFiles\": $ret_files, \"owner\": \"$eowner\", \"otherOwner\": 0, \"groupOrOtherBits\": 0}" \
