{
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "Write|Edit|NotebookEdit|MultiEdit",
    "hooks": [
     {
      "type": "command",
      "command": "if [ -z \"$MTH_GUARD_ROOT\" ]; then echo \"write guard: MTH_GUARD_ROOT is not set (run agents through tools/agents/run-agent.sh)\" >&2; exit 2; fi; g=\"$MTH_GUARD_ROOT/tools/agents/guard-write.mjs\"; if [ -f \"$g\" ]; then node \"$g\" code-security-reviewer; rc=$?; else echo \"write guard missing\" >&2; rc=2; fi; [ \"$rc\" -eq 0 ] || exit 2"
     }
    ]
   }
  ]
 },
 "sandbox": {
  "enabled": true,
  "failIfUnavailable": true,
  "allowUnsandboxedCommands": false,
  "autoAllowBashIfSandboxed": true,
  "enableWeakerNestedSandbox": true,
  "filesystem": {
   "denyWrite": [
    "/root/mth-exp/clone/.claude",
    "/root/mth-exp/clone/.git",
    "/root/mth-exp/clone/.gitattributes",
    "/root/mth-exp/clone/.github",
    "/root/mth-exp/clone/.gitignore",
    "/root/mth-exp/clone/.mcp.json",
    "/root/mth-exp/clone/CLAUDE.local.md",
    "/root/mth-exp/clone/CLAUDE.md",
    "/root/mth-exp/clone/docs/analysis",
    "/root/mth-exp/clone/docs/delivery/agent-protocol.md",
    "/root/mth-exp/clone/docs/delivery/agents.md",
    "/root/mth-exp/clone/docs/delivery/assignments",
    "/root/mth-exp/clone/docs/delivery/candidates",
    "/root/mth-exp/clone/docs/delivery/decisions.md",
    "/root/mth-exp/clone/docs/delivery/environment.md",
    "/root/mth-exp/clone/docs/delivery/findings.json",
    "/root/mth-exp/clone/docs/delivery/gates",
    "/root/mth-exp/clone/docs/delivery/handbacks",
    "/root/mth-exp/clone/docs/delivery/progress.md",
    "/root/mth-exp/clone/docs/delivery/requirements-spec.md",
    "/root/mth-exp/clone/docs/delivery/requirements.csv",
    "/root/mth-exp/clone/docs/delivery/reviews",
    "/root/mth-exp/clone/docs/delivery/runs",
    "/root/mth-exp/clone/docs/delivery/stages.json",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/agent-load",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/agent-smoke",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/audit",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/domain",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/orchestrator-probes",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/qa",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/round-12-orphaned",
    "/root/mth-exp/clone/docs/delivery/test-evidence/DG0/round-5-orphaned",
    "/root/mth-exp/clone/docs/delivery/threat-model.md",
    "/root/mth-exp/clone/docs/source",
    "/root/mth-exp/clone/tools",
    "/root/mth-exp/clone/tools/agents",
    "/root/mth-exp/clone/tools/gates",
    "/root/mth-exp/clone/tools/source",
    "/root/mth-exp/clone/trading_agent"
   ]
  }
 }
}
