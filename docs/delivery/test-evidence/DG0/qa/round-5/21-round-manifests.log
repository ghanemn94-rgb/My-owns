import { readFileSync } from "node:fs";
const repo = process.argv[2];
const rules = await import(repo + "/tools/gates/lib/rules.mjs");
const st = JSON.parse(readFileSync(repo + "/docs/delivery/stages.json", "utf8")).stages.find((s) => s.id === "DG0");
for (const r of st.review_rounds) {
  const errors = [];
  const m = rules.findManifest(repo, "DG0", r.candidate_id, errors, `round ${r.round}`);
  console.log(`round ${r.round} ${r.candidate_id.slice(7, 23)} alg=${m && (m.hash_algorithm || "(none=v1)")} frozen_at_match=${m && m.frozen_at === r.frozen_at} source_commit_match=${m && m.source_commit === r.source_commit} errors=${errors.length ? errors.join(" | ") : 0}`);
}
