### CI workflow (.github/workflows/delivery-gates.yml @85a0efa)
     1	# Delivery gate enforcement (master prompt §0.5, acceptance A24/A25).
     2	# The product build jobs added from P1 onward must declare `needs: delivery-gates`, so a failed or
     3	# unapproved gate stops the automated pipeline from advancing.
     4	name: delivery-gates
     5	
     6	on:
     7	  push:
     8	  pull_request:
     9	  workflow_dispatch:
    10	
    11	permissions:
    12	  contents: read
    13	
    14	jobs:
    15	  delivery-gates:
    16	    runs-on: ubuntu-24.04
    17	    steps:
    18	      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
    19	        with:
    20	          fetch-depth: 0 # historical gate verification recomputes candidates from recorded commits
    21	      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
    22	        with:
    23	          node-version: "22"
    24	      - name: Source extraction is reproducible
    25	        run: tools/source/check_extraction.sh
    26	      - name: Gate validator self-tests
    27	        run: node --test tools/gates/tests/*.test.mjs
    28	      - name: Write-guard tests
    29	        run: node --test tools/agents/tests/*.test.mjs
    30	      - name: Runner metadata tests
    31	        run: python3 -m unittest discover -s tools/agents/tests -p 'test_*.py'
    32	      - name: Pipeline gate state (approved gates re-verified; no stage advanced past an unapproved gate)
    33	        run: node tools/gates/validate.mjs --pipeline
    34	      - name: Resumption reconciliation report
    35	        run: node tools/gates/validate.mjs --reconcile

