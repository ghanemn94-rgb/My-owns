== CI workflow ==
# Delivery gate enforcement (master prompt §0.5, acceptance A24/A25).
# The product build jobs added from P1 onward must declare `needs: delivery-gates`, so a failed or
# unapproved gate stops the automated pipeline from advancing.
name: delivery-gates

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  delivery-gates:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0 # historical gate verification recomputes candidates from recorded commits
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "22"
      - name: Install the OS sandbox used by the gate tooling (bubblewrap, D-025/D-026)
        run: |
          sudo apt-get update -q
          sudo apt-get install -y -q bubblewrap
          # Ubuntu 24.04 restricts unprivileged user namespaces through AppArmor; bubblewrap needs them.
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          bwrap --ro-bind / / --unshare-net -- true
      - name: Source extraction is reproducible
        run: tools/source/check_extraction.sh
      - name: Gate validator self-tests
        run: node --test tools/gates/tests/*.test.mjs
      - name: Write-guard tests
        run: node --test tools/agents/tests/*.test.mjs
      - name: Runner metadata tests
        run: python3 -m unittest discover -s tools/agents/tests -p 'test_*.py'
      - name: Pipeline gate state (approved gates re-verified; no stage advanced past an unapproved gate)
        run: node tools/gates/validate.mjs --pipeline
      - name: Resumption reconciliation report
        run: node tools/gates/validate.mjs --reconcile
