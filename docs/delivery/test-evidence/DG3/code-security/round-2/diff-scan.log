## S12 zod mirror vs OpenAPI GateInheritedApproval
      GateInheritedApproval:
        type: object
        description: "Annotation of a product gate with its inherited approval (ADR-0021 §5). When several exist, the one shown is the one that counts, else the newest pending one, else the newest. Evidence of an approval granted before the product was used; it never approves the gate."
        required: [dispensationId, status, counts, approvingBody, approvedOn]
        additionalProperties: false
        properties:
          dispensationId: { $ref: "#/components/schemas/Uuid" }
          status: { type: string, enum: [pending_verification, accepted, rejected, revoked], description: "The dispensation's status; `pending` is shown as pending_verification (evidence verification and acceptance by another person outstanding)." }
          counts: { type: boolean, description: "Whether it satisfies the sequencing rule now, by the same rule sequencing uses: Modular transformation, accepted, evidence verified." }
          approvingBody: { type: string, minLength: 1, maxLength: 300 }
          approvedOn: { $ref: "#/components/schemas/BusinessDate" }
  export const gateInheritedApproval = z.strictObject({
    dispensationId: uuid,
    status: z.enum(INHERITED_APPROVAL_STATUSES),
    counts: z.boolean(),
    approvingBody: z.string().min(1).max(300),
    approvedOn: businessDate,
  });
