diff --git a/apps/web/e2e/p5-record-name-reflow.spec.ts b/apps/web/e2e/p5-record-name-reflow.spec.ts
new file mode 100644
index 0000000..1a8052e
--- /dev/null
+++ b/apps/web/e2e/p5-record-name-reflow.spec.ts
@@ -0,0 +1,170 @@
+// Record names with long unbroken text reflow on Traceability and Modular entry, and the Define page's outcome card
+// fits narrow phones (T-DG5-FE-AB1, D-180; F-DG5-148, F-DG5-149; REQ-S15-009, REQ-S15-012 WCAG 2.1 SC 1.4.10 Reflow),
+// against the REAL API (apps/web/e2e/support/with-stack.sh), in chromium-en and chromium-ar.
+// It turns the qa-verifier's round-6 probes into product tests that keep their final assertion,
+// document.documentElement.scrollWidth - innerWidth <= 1 (read, not imported:
+// docs/delivery/test-evidence/DG5/qa/tests/round-6/e2e/zz-qa-dg5r6-title-reflow-verify.spec.ts, R6-TITLE-B, and
+// zz-qa-dg5r6-define-narrow.spec.ts, R6-DEFINE-NARROW):
+//  - F-DG5-148: per language and token (a 120-character word without spaces, the 46-character token, an unbroken
+//    Arabic token joined by underscores, ordinary text), a SYNTHETIC transformation with one Define outcome whose
+//    statement holds the token. The outcome is a node of the Traceability graph (its record link, RecordName) and,
+//    having no KPI, an item of the Modular entry "missing" list (the label "· <statement>"). Both pages are opened at
+//    390, 360 and 320 px wide and at 1280 px with the root font at 200 %. Asserted: no page-level horizontal scroll,
+//    the token is on the page (set-up check), and every element whose text holds the token lies inside the viewport
+//    (in ar an overflow runs past the LEFT edge).
+//  - F-DG5-149: a SYNTHETIC transformation with one ORDINARY outcome; Define at 390, 375, 360 and 320 px and at 200 %.
+//    Asserted: no page-level horizontal scroll, the outcome card inside the viewport, and the Good-outcome test table
+//    inside a focusable scroll region named by its localized caption.
+// It collects every measurement first and then asserts once, so a failure names each failing case. Everything is
+// SYNTHETIC demo data; nothing here grants a business approval (G1-G6) or touches the delivery gates DG0-DG7.
+import { expect, test, type Page } from "@playwright/test";
+import { asUser } from "./support/p3-journey-setup.ts";
+import { apiSession, langOf, shot, SYN_RETAIL, tr } from "./support/ui.ts";
+
+const stamp = Date.now().toString(36);
+const TOKENS = {
+  w120: `Synthetic_${"ABCDEFGHIJ".repeat(11)}`, // 120 characters, no break opportunity
+  w46: "Synthetic_roaming_bill_shock_reduction_program",
+  arU: "اصطناعي_برنامج_خفض_صدمة_فواتير_التجوال_للمسافرين_الدوليين_عبر_التطبيق", // unbroken Arabic
+  plain: "Synthetic churn reduction on the prepaid base",
+} as const;
+const SIZES = [
+  ["390", 390, 0],
+  ["360", 360, 0],
+  ["320", 320, 0],
+  ["200pct", 1280, 200],
+] as const;
+
+async function settle(page: Page, font: number) {
+  if (font) await page.evaluate((f) => (document.documentElement.style.fontSize = `${f}%`), font);
+  await page.waitForLoadState("networkidle");
+  await page.waitForTimeout(300);
+}
+
+/** Page overflow, and the innermost elements of main#main whose text holds `token` that lie outside the viewport
+ *  without a horizontal scroll container between them and the page. */
+async function measure(page: Page, token: string) {
+  return page.evaluate((token) => {
+    const W = window.innerWidth;
+    const main = document.querySelector<HTMLElement>("main#main");
+    const inScroller = (el: Element) => {
+      for (let x = el.parentElement; x && x !== document.body; x = x.parentElement) {
+        const ox = getComputedStyle(x).overflowX;
+        if (ox === "auto" || ox === "scroll" || ox === "hidden" || ox === "clip") return true;
+      }
+      return false;
+    };
+    const outside: string[] = [];
+    for (const el of Array.from(main?.querySelectorAll<HTMLElement>("*") ?? [])) {
+      if (!(el.textContent ?? "").includes(token)) continue;
+      const r = el.getBoundingClientRect();
+      if (r.width === 0 || r.height === 0 || inScroller(el)) continue;
+      if (r.left < -1 || r.right > W + 1)
+        outside.push(`${el.tagName.toLowerCase()}.${el.className} [${Math.round(r.left)}..${Math.round(r.right)}]`);
+    }
+    return {
+      pageOverflow: document.documentElement.scrollWidth - W,
+      tokenPresent: (main?.textContent ?? "").includes(token),
+      outside: outside.slice(0, 6),
+    };
+  }, token);
+}
+
+test("Record names with long unbroken text wrap on Traceability (graph record link) and Modular entry (missing-item label) at 390, 360, 320 px and with 200 % text", async ({
+  browser,
+  playwright,
+}, info) => {
+  test.setTimeout(420_000);
+  const lang = langOf(info);
+  const lead = await apiSession(playwright, "dev.lead");
+  const failures: string[] = [];
+  const report: string[] = [];
+  for (const [k, token] of Object.entries(TOKENS)) {
+    const tid = (
+      await lead.call<{ id: string }>("POST", "/api/v1/transformations", {
+        businessUnitId: SYN_RETAIL,
+        name: `Synthetic AB1 ${k} ${lang} ${stamp}`,
+        mode: "end_to_end",
+      })
+    ).id;
+    await lead.call("POST", `/api/v1/transformations/${tid}/outcomes`, { statement: `AB1 ${token}` });
+    const u = await asUser(browser, lang, "dev.lead");
+    const screens = [
+      ["traceability", `/transformations/${tid}/traceability`, "li.trace-node a.link"],
+      ["modular", `/transformations/${tid}/modular-entry`, "ul[data-missing-items] > li"],
+    ] as const;
+    for (const [screen, url, holder] of screens) {
+      for (const [label, width, font] of SIZES) {
+        await u.page.setViewportSize({ width, height: 900 });
+        await u.page.goto(url);
+        await expect(u.page.locator(holder, { hasText: token }).first()).toBeVisible({ timeout: 20_000 });
+        await settle(u.page, font);
+        const m = await measure(u.page, token);
+        const name = `${k}/${screen}/${label}`;
+        report.push(`${name}: overflow ${m.pageOverflow}`);
+        if (!m.tokenPresent) failures.push(`${name}: set-up, the token is not on the page`);
+        if (m.pageOverflow > 1) failures.push(`${name}: the page scrolls horizontally by ${m.pageOverflow} px`);
+        if (m.outside.length > 0) failures.push(`${name}: token text outside the viewport ${m.outside.join(", ")}`);
+        if (label === "320" && k !== "plain") await shot(u.page, lang, `p5-record-name-${k}-${screen}-320`);
+      }
+    }
+    await u.close();
+  }
+  console.info(`Record name reflow ${lang}: ${report.join("; ")}`);
+  expect(failures).toEqual([]);
+});
+
+test("Define: the outcome card with ordinary text fits 390, 375, 360 and 320 px and 200 % text; the Good-outcome test table scrolls in its own named region", async ({
+  browser,
+  playwright,
+}, info) => {
+  test.setTimeout(240_000);
+  const lang = langOf(info);
+  const lead = await apiSession(playwright, "dev.lead");
+  const statement = "Synthetic: fewer roaming bill complaints";
+  const tid = (
+    await lead.call<{ id: string }>("POST", "/api/v1/transformations", {
+      businessUnitId: SYN_RETAIL,
+      name: `Synthetic AB1 define ${lang} ${stamp}`,
+      mode: "end_to_end",
+    })
+  ).id;
+  await lead.call("POST", `/api/v1/transformations/${tid}/outcomes`, { statement });
+  const u = await asUser(browser, lang, "dev.lead");
+  const regionName = tr(lang, "common.table.scrollRegion", {
+    caption: tr(lang, "define.goodOutcome.caption", { outcome: statement }),
+  });
+  const failures: string[] = [];
+  const report: string[] = [];
+  for (const [label, width, font] of [["375", 375, 0] as const, ...SIZES]) {
+    await u.page.setViewportSize({ width, height: 900 });
+    await u.page.goto(`/transformations/${tid}/define`);
+    await expect(u.page.locator(".outcome-card__title", { hasText: statement })).toBeVisible({ timeout: 20_000 });
+    await settle(u.page, font);
+    // The table's scroll region: focusable and named by the localized caption (collected, not thrown, so a missing
+    // region still reports the page overflow below).
+    const region = u.page.getByRole("region", { name: regionName });
+    const regions = await region.count();
+    const inRegion = regions === 1 ? await region.locator("table.good-outcome__table").count() : 0;
+    const focusable = regions === 1 ? await region.getAttribute("tabindex") : null;
+    if (regions !== 1 || inRegion !== 1 || focusable !== "0")
+      failures.push(`define/${label}: the Good-outcome table is not in one focusable region named "${regionName}"`);
+    const m = await u.page.evaluate(() => {
+      const W = window.innerWidth;
+      const card = document.querySelector(".outcome-card")!.getBoundingClientRect();
+      return {
+        pageOverflow: document.documentElement.scrollWidth - W,
+        card: [Math.round(card.left), Math.round(card.right)] as [number, number],
+        W,
+      };
+    });
+    report.push(`define/${label}: overflow ${m.pageOverflow}, card [${m.card[0]}..${m.card[1]}]`);
+    if (m.pageOverflow > 1) failures.push(`define/${label}: the page scrolls horizontally by ${m.pageOverflow} px`);
+    if (m.card[0] < -1 || m.card[1] > m.W + 1)
+      failures.push(`define/${label}: the outcome card [${m.card[0]}..${m.card[1]}] is outside the viewport`);
+    if (label === "320" || label === "360") await shot(u.page, lang, `p5-define-outcome-card-${label}`);
+  }
+  await u.close();
+  console.info(`Define reflow ${lang}: ${report.join("; ")}`);
+  expect(failures).toEqual([]);
+});
diff --git a/apps/web/e2e/p5-transformation-picker-complete.spec.ts b/apps/web/e2e/p5-transformation-picker-complete.spec.ts
new file mode 100644
index 0000000..395a00a
--- /dev/null
+++ b/apps/web/e2e/p5-transformation-picker-complete.spec.ts
@@ -0,0 +1,91 @@
+// T-DG5-FE-AB2 (D-181; REQ-S15 usability): a transformation picker offers EVERY transformation the user may see, not
+// one page of them. Against the REAL API (apps/web/e2e/support/with-stack.sh), in EN and AR.
+//  - Through the API, the lead (TL) makes sure more than 100 transformations exist (PAGINATION.maxLimit is 100, the
+//    page size the old picker loaded once), then creates one more: the newest, whose code sorts last.
+//  - The API itself shows the regression's precondition: the first page of `code:asc` (limit 100) does not contain
+//    the newest one, so a one-page picker cannot offer it.
+//  - On "My procedures", the launch form's transformation picker (shown once `baseline_validation`, a
+//    transformation-scoped procedure, is chosen) offers the newest one and as many options as the API lists in all
+//    of its pages. It is chosen; nothing is launched (the launch itself is covered by p5-procedure-outputs.spec.ts).
+// All data is SYNTHETIC. Nothing here is a business approval, and nothing touches the engineering gates DG0-DG7.
+import { expect, test, type Page } from "@playwright/test";
+import {
+  SYN_RETAIL,
+  apiSession,
+  expectAccessible,
+  langOf,
+  shot,
+  signIn,
+  tr,
+  trackRequests,
+  type Lang,
+} from "./support/ui.ts";
+
+const h1 = (page: Page) => page.locator("main#main h1");
+const PAGE_LIMIT = 100;
+
+interface TrPage {
+  items: { id: string; code: string }[];
+  nextCursor: string | null;
+}
+
+test("Transformation picker: with more than 100 transformations, the launch-procedure picker offers the newest one", async ({
+  page,
+  playwright,
+}, info) => {
+  test.setTimeout(240_000);
+  const lang: Lang = langOf(info);
+  const foreign = trackRequests(page);
+  const lead = await apiSession(playwright, "dev.lead");
+
+  /** Every transformation the lead may see, through every page of the list operation. */
+  const listAll = async () => {
+    const all: { id: string; code: string }[] = [];
+    let cursor: string | null = null;
+    do {
+      const query = new URLSearchParams({ sort: "code:asc", limit: String(PAGE_LIMIT) });
+      if (cursor) query.set("cursor", cursor);
+      const p: TrPage = await lead.call<TrPage>("GET", `/api/v1/transformations?${query.toString()}`);
+      all.push(...p.items);
+      cursor = p.nextCursor;
+    } while (cursor);
+    return all;
+  };
+
+  // 1. More than 100 transformations exist (the ones already in this database count), then the newest one.
+  const before = await listAll();
+  for (let i = before.length; i <= PAGE_LIMIT; i++) {
+    await lead.call("POST", "/api/v1/transformations", {
+      businessUnitId: SYN_RETAIL,
+      name: `Synthetic FE-AB2 ${lang.toUpperCase()} filler ${i + 1}`,
+      mode: "end_to_end",
+    });
+  }
+  const newest = await lead.call<{ id: string; code: string }>("POST", "/api/v1/transformations", {
+    businessUnitId: SYN_RETAIL,
+    name: `Synthetic FE-AB2 ${lang.toUpperCase()} newest`,
+    mode: "end_to_end",
+  });
+  const all = await listAll();
+  expect(all.length).toBeGreaterThan(PAGE_LIMIT);
+  expect(all.map((x) => x.id)).toContain(newest.id);
+  const firstPage = await lead.call<TrPage>("GET", `/api/v1/transformations?sort=code:asc&limit=${PAGE_LIMIT}`);
+  expect(firstPage.nextCursor).not.toBeNull();
+  expect(firstPage.items.map((x) => x.id)).not.toContain(newest.id);
+
+  // 2. The launch-procedure picker offers the newest one, and every transformation the API lists.
+  await signIn(page, lang, "dev.lead");
+  await page.goto("/playbook/procedures");
+  await expect(h1(page)).toHaveText(tr(lang, "nav.p5.myProcedures.title"));
+  const launch = page.locator("[data-form='launch-procedure']");
+  await launch.getByLabel(tr(lang, "workflowsP5.procedures.procedure")).selectOption("baseline_validation");
+  const picker = launch.getByLabel(tr(lang, "workflowsP5.field.transformation"));
+  await expect(picker.locator(`option[value="${newest.id}"]`)).toHaveCount(1);
+  await expect(picker.locator("option:not([value=''])")).toHaveCount(all.length);
+  await picker.selectOption(newest.id);
+  await expect(picker).toHaveValue(newest.id);
+  await expect(page.locator("html")).toHaveAttribute("dir", lang === "ar" ? "rtl" : "ltr");
+  await shot(page, lang, "fe-ab2-launch-picker-all-transformations");
+  await expectAccessible(page, lang, "fe-ab2-launch-picker-all-transformations");
+  expect(foreign).toEqual([]);
+});
diff --git a/apps/web/src/api/all-transformations.test.tsx b/apps/web/src/api/all-transformations.test.tsx
new file mode 100644
index 0000000..c8f54c8
--- /dev/null
+++ b/apps/web/src/api/all-transformations.test.tsx
@@ -0,0 +1,231 @@
+// T-DG5-FE-AB2 (D-181; REQ-S15 usability): a transformation picker offers every transformation the user may see.
+// fetchAllTransformations / useAllTransformations follow `nextCursor` of the existing list operation
+// (GET /api/v1/transformations, PAGINATION.maxLimit per page) until it is null, and a page that fails fails the whole
+// list (a picker never offers a partial list as if it were complete).
+//  H1  one page: one request, limit 100, no cursor; its items.
+//  H2  several pages: each cursor is sent once, in order; every item of every page, in order; the filters on every page.
+//  H3  an error mid-way (page 2 of 3 answers 500): the query is an error with NO data, and page 3 is never requested.
+//  H4  a server that repeats a cursor: an error, never an endless loop or a silently shortened list.
+//  H5  the request signal reaches every page request (the same cancellation convention as useTransformations).
+//  P1  the launch-procedure picker on "My procedures", EN (LTR) and AR (RTL): 250 transformations over three pages are
+//      all offered, the last one (past the old 100 cap) included.
+//  P2  the same picker when page 2 fails: the translated error state with "Try again", no picker with a partial list.
+// SYNTHETIC data, scripted API (the product's own test fixtures). Nothing here is a business approval.
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, renderHook, screen, waitFor, within } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Permission } from "@mth/shared";
+import { createI18n, catalogues } from "../i18n/index.ts";
+import {
+  ORG_ID,
+  makeMe,
+  makeTransformation,
+  mockApi,
+  renderApp,
+  route,
+  type RecordedRequest,
+} from "../test/fixtures.tsx";
+import { ApiError } from "./client.ts";
+import { fetchAllTransformations, useAllTransformations } from "./queries.ts";
+import type { Transformation } from "./types.ts";
+
+beforeEach(() => localStorage.clear());
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+const PAGE = 100;
+const idOf = (n: number) => `01920000-0000-7000-a1b2-${String(n).padStart(12, "0")}`;
+const many = (count: number): Transformation[] =>
+  Array.from({ length: count }, (_, i) =>
+    makeTransformation({
+      id: idOf(i + 1),
+      code: `TR-${String(i + 1).padStart(4, "0")}`,
+      name: `Synthetic transformation ${i + 1}`,
+    }),
+  );
+const isList = (r: RecordedRequest) => r.method === "GET" && /\/api\/v1\/transformations\?/.test(r.url);
+const paramsOf = (r: RecordedRequest) => new URL(r.url, "http://localhost").searchParams;
+
+/** Serves `all` in pages of 100 with opaque cursors ("c1", "c2", ...); `fail` answers that page number with a 500. */
+function pagedTransformations(all: readonly Transformation[], opts: { fail?: number; repeatCursor?: boolean } = {}) {
+  return route("GET", /\/api\/v1\/transformations\?/, (req) => {
+    const cursor = paramsOf(req).get("cursor");
+    const index = cursor ? Number(cursor.slice(1)) : 0;
+    if (opts.fail === index + 1) return { status: 500, body: { title: "Synthetic outage", status: 500 } };
+    const items = all.slice(index * PAGE, (index + 1) * PAGE);
+    const more = (index + 1) * PAGE < all.length;
+    return { status: 200, body: { items, nextCursor: more ? (opts.repeatCursor ? "c1" : `c${index + 1}`) : null } };
+  });
+}
+
+function wrapper() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return ({ children }: { children: ReactNode }) => (
+    <QueryClientProvider client={client}>{children}</QueryClientProvider>
+  );
+}
+
+describe("fetchAllTransformations / useAllTransformations (D-181)", () => {
+  it("H1 one page: one request with limit 100 and no cursor", async () => {
+    const api = mockApi(pagedTransformations(many(3)));
+    const { result } = renderHook(() => useAllTransformations({ sort: "code:asc" }), { wrapper: wrapper() });
+    await waitFor(() => expect(result.current.isSuccess).toBe(true));
+    expect(result.current.data?.map((x) => x.code)).toEqual(["TR-0001", "TR-0002", "TR-0003"]);
+    const lists = api.requests.filter(isList);
+    expect(lists).toHaveLength(1);
+    expect(paramsOf(lists[0]!).get("limit")).toBe(String(PAGE));
+    expect(paramsOf(lists[0]!).get("sort")).toBe("code:asc");
+    expect(paramsOf(lists[0]!).has("cursor")).toBe(false);
+  });
+
+  it("H2 several pages: follows nextCursor until null, keeps the filters, returns every item in order", async () => {
+    const all = many(250);
+    const api = mockApi(pagedTransformations(all));
+    const { result } = renderHook(
+      () => useAllTransformations({ sort: "updatedAt:desc", organizationId: ORG_ID, includeArchived: false }),
+      { wrapper: wrapper() },
+    );
+    await waitFor(() => expect(result.current.isSuccess).toBe(true));
+    expect(result.current.data).toHaveLength(250);
+    expect(result.current.data?.map((x) => x.id)).toEqual(all.map((x) => x.id));
+    const lists = api.requests.filter(isList).map(paramsOf);
+    expect(lists.map((p) => p.get("cursor"))).toEqual([null, "c1", "c2"]);
+    for (const p of lists) {
+      expect(p.get("limit")).toBe(String(PAGE));
+      expect(p.get("sort")).toBe("updatedAt:desc");
+      expect(p.get("organizationId")).toBe(ORG_ID);
+      expect(p.has("includeArchived")).toBe(false);
+    }
+  });
+
+  it("H3 an error mid-way: the query is an error with no partial data, and no later page is requested", async () => {
+    const api = mockApi(pagedTransformations(many(250), { fail: 2 }));
+    const { result } = renderHook(() => useAllTransformations({ sort: "code:asc" }), { wrapper: wrapper() });
+    await waitFor(() => expect(result.current.isError).toBe(true));
+    expect(result.current.data).toBeUndefined();
+    expect(result.current.error).toBeInstanceOf(ApiError);
+    expect((result.current.error as ApiError).status).toBe(500);
+    expect(
+      api.requests
+        .filter(isList)
+        .map(paramsOf)
+        .map((p) => p.get("cursor")),
+    ).toEqual([null, "c1"]);
+  });
+
+  it("H4 a repeated cursor is an error, not an endless loop or a shortened list", async () => {
+    const api = mockApi(pagedTransformations(many(350), { repeatCursor: true }));
+    await expect(fetchAllTransformations({ sort: "code:asc" })).rejects.toThrow(/repeated a page cursor/);
+    expect(api.requests.filter(isList)).toHaveLength(2);
+  });
+
+  it("H5 the request signal is passed to every page request", async () => {
+    mockApi(pagedTransformations(many(150)));
+    const signals: (AbortSignal | null | undefined)[] = [];
+    const scripted = globalThis.fetch;
+    vi.stubGlobal("fetch", (input: RequestInfo | URL, init?: RequestInit) => {
+      signals.push(init?.signal);
+      return scripted(input, init);
+    });
+    const controller = new AbortController();
+    const items = await fetchAllTransformations({ sort: "code:asc" }, controller.signal);
+    expect(items).toHaveLength(150);
+    expect(signals).toHaveLength(2);
+    for (const s of signals) expect(s).toBeTruthy();
+    controller.abort();
+    for (const s of signals) expect(s?.aborted).toBe(true);
+  });
+});
+
+// ------------------------------------------------------------------------------------------------ the picker (P1, P2)
+
+const PERMISSIONS = ["organization.read", "procedure.read", "procedure.act", "transformation.read"] as Permission[];
+const definitions = {
+  items: [
+    {
+      id: "01920000-0000-7000-b200-000000000002",
+      code: "baseline_validation",
+      nameEn: "Synthetic baseline validation",
+      nameAr: "التحقق من خط الأساس (اصطناعي)",
+      versionNo: 2,
+      versionStatus: "published",
+      removed: false,
+      scope: { level: "transformation" },
+      inputSchema: [],
+      steps: [],
+    },
+  ],
+  nextCursor: null,
+};
+
+function pickerApp(lang: "en" | "ar", opts: { fail?: number } = {}) {
+  const api = mockApi(
+    route("GET", /\/api\/v1\/me$/, () => ({
+      status: 200,
+      body: makeMe(
+        [{ scope: { type: "organization" as const, id: ORG_ID }, inheritsDownward: true, permissions: PERMISSIONS }],
+        { preferredLocale: lang },
+      ),
+    })),
+    route("GET", /\/api\/v1\/procedure-definitions(\?|$)/, () => ({ status: 200, body: definitions })),
+    pagedTransformations(many(250), opts),
+    route("GET", /./, () => ({ status: 200, body: { items: [], nextCursor: null } })),
+  );
