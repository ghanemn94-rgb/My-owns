+/* T-DG5-FE-Z1C (F-DG5-146 follow-up, D-176; WCAG 1.4.10 Reflow): a grid track's default minimum is its content's
+   min-content width, so a wide table (the T14 export preview) widened the dialog's body past the dialog at 390 px and
+   ran off the viewport. The dialog's tracks may shrink to the dialog; wide content scrolls inside its focusable, named
+   .table-wrap, and the footer's actions wrap. */
+.dialog,
+.dialog__body {
+  grid-template-columns: minmax(0, 1fr);
+}
 .dialog__title {
   margin: 0;
 }
