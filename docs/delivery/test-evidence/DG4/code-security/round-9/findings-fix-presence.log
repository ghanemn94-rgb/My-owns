225: async function amend(tx: Tx, request: FastifyRequest, transformationId: string, id: string) {
226:   const ctx = await openFinanceWrite(tx, request, transformationId);
227:   const body = parseBody(financeValidationAmendment, request.body);
228:   const target = await openTarget(tx, request, transformationId, id);
229:   const delta = amendmentDelta(body.correctedAmount, target.current);
230:   if (new D(delta).isZero()) throw amendmentUnchanged();
231:   return createCorrection(tx, ctx, target, "amendment", delta, body.reason);
232: }
