-- corrections.ts lines 202-240:
202: async function stepOriginal(tx: Tx, ctx: WriteContext, validation: FinanceValidationRow, reason: string) {
203:   const stepped = await tx
204:     .updateTable("finance_validation")
205:     .set(bumpStamps(ctx.userId))
206:     .where("id", "=", validation.id)
207:     .where("version", "=", validation.version)
208:     .returning(["version"])
209:     .executeTakeFirst();
210:   // The row is locked FOR UPDATE by openTarget, so the version cannot have moved; refuse rather than write blind.
211:   if (!stepped) throw problems.versionConflict(validation.version);
212:   await record(tx, ctx.audit, {
213:     action: "finance_validation.corrected",
214:     recordType: "finance_validation",
215:     recordId: validation.id,
216:     organizationId: ctx.organizationId,
217:     transformationId: ctx.transformationId,
218:     priorVersion: validation.version,
219:     newVersion: stepped.version,
220:     reason,
221:     changes: { version: { from: validation.version, to: stepped.version } },
222:   });
223: }
