+/**
+ * The read permission of every output record type, as the record's own GET checks it, always in the record's
+ * transformation: transformation (GET /transformations/{id}), charter, baseline, kpi_actual, tom_canvas_cell,
+ * ranking_snapshot, gate_submission, change_request, finance_validation, decision, bau_handover, evidence and approval
+ * (each module's read gate is `requireTransformationRead`, i.e. this permission on that transformation).
+ */
+export const OUTPUT_READ_PERMISSION: Permission = "transformation.read";
+
+/**
+ * F-DG5-101 (D-170): the acting person may read the record (OUTPUT_READ_PERMISSION in its transformation), on
+ * `principal`'s grants (the engine's, reloaded inside the completing transaction), else 422 output_record_invalid -
+ * the unknown-record refusal, with the read gate's denial attached for the failed-mutation audit (never in the body).
+ * A null principal is an approval step completing through its business approver's decision (workflows): it names no
+ * record, and its `advance` acts on the record an earlier step linked after this same check.
+ */
+export async function requireOutputRead(
+  tx: DbOrTx,
+  principal: Principal | null,
+  recordTransformationId: string,
+): Promise<void> {
+  if (principal === null) return;
+  try {
+    await requireRead(tx, principal, OUTPUT_READ_PERMISSION, { type: "transformation", id: recordTransformationId });
+  } catch (err) {
+    if (!(err instanceof HttpProblem) || err.status !== 404) throw err;
+    const refused = outputRecordInvalid();
+    throw err.denial === undefined ? refused : refused.withDenial(err.denial);
+  }
+}
+
+/**
+ * The same read check for a record the engine links WITHOUT an adapter (steps.ts's generic `link`, e.g. an `approval`
+ * named by a task step): every output table has `transformation_id` (`transformation`: its id). A record that does
+ * not exist is left to the link guard (procedure_instance_link_record_ref), as before.
+ */
+export async function requireNamedRecordRead(
+  tx: DbOrTx,
+  principal: Principal | null,
+  recordType: string,
+  recordId: string,
+): Promise<void> {
+  if (principal === null) return;
+  const column = recordType === "transformation" ? "id" : "transformation_id";
+  const res = await sql<{ transformation_id: string }>`
+    SELECT ${sql.ref(column)} AS transformation_id FROM ${sql.table(recordType)} WHERE id = ${recordId}`.execute(tx);
+  const row = res.rows[0];
+  if (row === undefined) return;
+  await requireOutputRead(tx, principal, row.transformation_id);
+}
