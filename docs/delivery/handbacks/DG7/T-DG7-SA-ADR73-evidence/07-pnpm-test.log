}
c11_cleanup() {
  if [ \"$KEEP\" = 1 ]; then
    echo \"--keep: projects $SRC and $DST left running\"
    return 0
  fi
  local rc=0
  dc -p \"$DST\" --profile backup down -v --remove-orphans || rc=$?
  dc -p \"$SRC\" --profile backup down -v --remove-orphans || rc=$?
  return \"$rc\"
}

