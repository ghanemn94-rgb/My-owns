## script tx-await-sweep.mjs
// Lists every `await` / `for await` that runs while a transaction or a checked-out pooled client is held:
//  (1) inside a callback passed to `<x>.transaction().execute(cb)` or `withTransaction(<db>, cb)`;
//  (2) inside any function with a parameter typed Tx / DbOrTx / Transaction<...> / PoolClient / pg.PoolClient
//      (helpers called from a transaction receive it as a parameter, so every helper body is scanned too);
//  (3) between `<pool>.connect()` and `.release()` in the same function (raw pg clients).
// Each await is classified "db" when the awaited expression references the handle (the tx/client parameter or a
// name bound to it) or passes it as an argument, else "REVIEW". Usage: node tx-await-sweep.mjs <repo> <file...>
import { createRequire } from "node:module";
import { readFileSync } from "node:fs";
const repo = process.argv[2];
const require = createRequire(repo + "/package.json");
const ts = require("typescript");
const files = process.argv.slice(3);
const HANDLE_TYPE = /^(Tx|DbOrTx|Transaction<.*>|PoolClient|pg\.PoolClient|Kysely<.*>|Db|WriteContext)$/;
const out = [];
for (const file of files) {
  const src = ts.createSourceFile(file, readFileSync(file, "utf8"), ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
  const line = (n) => src.getLineAndCharacterOfPosition(n.getStart(src)).line + 1;
  const scanBody = (fn, handles, ctx) => {
    const visit = (n, nested) => {
      if (n !== fn && ts.isFunctionLike(n)) {
        // nested function: scanned with the same handles (a callback inside the transaction still runs in it)
        n.forEachChild((c) => visit(c, true));
        return;
      }
      let expr = null, kind = null;
      if (ts.isAwaitExpression(n)) { expr = n.expression; kind = "await"; }
      if (ts.isForOfStatement(n) && n.awaitModifier) { expr = n.expression; kind = "for await"; }
      if (expr) {
        const text = expr.getText(src).replace(/\s+/g, " ");
        const ids = new Set();
        const collect = (m) => { if (ts.isIdentifier(m)) ids.add(m.text); m.forEachChild(collect); };
        collect(expr);
        const isDb = [...handles].some((h) => ids.has(h));
        out.push({ file, line: line(n), ctx, kind, nested, cls: isDb ? "db" : "REVIEW", text: text.slice(0, 160) });
      }
      n.forEachChild((c) => visit(c, nested));
    };
    fn.forEachChild((c) => visit(c, false));
  };
  const walk = (n) => {
    // (1) transaction callbacks
    if (ts.isCallExpression(n)) {
      const callee = n.expression.getText(src);
      const isTxExec = /\.transaction\(\)\s*\.execute$/.test(callee.replace(/\s+/g, ""));
      const isWith = /(^|\.)withTransaction$/.test(callee);
      const cb = isTxExec ? n.arguments[0] : isWith ? n.arguments[1] : null;
      if (cb && ts.isFunctionLike(cb)) {
        const handles = new Set(["tx", "trx"]);
        for (const p of cb.parameters ?? []) if (ts.isIdentifier(p.name)) handles.add(p.name.text);
        scanBody(cb, handles, `transaction callback @${line(n)}`);
      }
    }
    // (2) functions with a handle-typed parameter
    if (ts.isFunctionLike(n) && n.parameters && n.body) {
      const handles = new Set();
      for (const p of n.parameters) {
        if (p.type && ts.isIdentifier(p.name) && HANDLE_TYPE.test(p.type.getText(src).replace(/\s+/g, ""))) handles.add(p.name.text);
      }
      // Db/Kysely parameters are NOT a held transaction; only scan when a Tx-like handle is present
      for (const p of n.parameters) if (ts.isIdentifier(p.name) && /^(tx|trx)$/.test(p.name.text)) handles.add(p.name.text);
      const txLike = n.parameters.some((p) => (p.type && /^(Tx|DbOrTx|Transaction<.*>|PoolClient|pg\.PoolClient|WriteContext)$/.test(p.type.getText(src).replace(/\s+/g, ""))) || (ts.isIdentifier(p.name) && /^(tx|trx)$/.test(p.name.text)));
      if (txLike) {
        const name = n.name ? n.name.getText(src) : "(anonymous)";
        scanBody(n, handles, `fn ${name}(${[...handles].join(",")}) @${line(n)}`);
      }
    }
    // (3) raw pool clients
    if (ts.isCallExpression(n) && /\.connect$/.test(n.expression.getText(src)) && n.arguments.length === 0) {
      out.push({ file, line: line(n), ctx: "pool client checkout", kind: "connect", nested: false, cls: "REVIEW", text: n.getText(src).slice(0, 160) });
    }
    n.forEachChild(walk);
  };
  walk(src);
}
const seen = new Set();
for (const o of out) {
  const k = `${o.file}:${o.line}:${o.text}`;
  if (seen.has(k)) continue; seen.add(k);
  console.log(`${o.cls}\t${o.file}:${o.line}\t${o.kind}${o.nested ? " (nested fn)" : ""}\t[${o.ctx}]\t${o.text}`);
}

## script spec-hooks.mjs
// Every await inside a register spec's `check` / `beforeInsert` property function (they run inside the register
// kit's write transaction and receive `ctx` = WriteContext, whose `tx` is the open transaction).
import { createRequire } from "node:module";
import { readFileSync } from "node:fs";
const require = createRequire(process.argv[2] + "/package.json");
const ts = require("typescript");
for (const file of process.argv.slice(3)) {
  const src = ts.createSourceFile(file, readFileSync(file, "utf8"), ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
  const walk = (n) => {
    if (ts.isPropertyAssignment(n) && ["check", "beforeInsert"].includes(n.name.getText(src)) && ts.isFunctionLike(n.initializer)) {
      const visit = (m) => {
        if (ts.isAwaitExpression(m)) {
          const t = m.expression.getText(src).replace(/\s+/g, " ");
          const db = /\bctx\.tx\b|\btx\b/.test(t);
          console.log(`${db ? "db" : "REVIEW"}\t${file}:${src.getLineAndCharacterOfPosition(m.getStart(src)).line + 1}\t[spec.${n.name.getText(src)}]\t${t.slice(0, 160)}`);
        }
        m.forEachChild(visit);
      };
      visit(n.initializer);
    }
    n.forEachChild(walk);
  };
  walk(src);
}
