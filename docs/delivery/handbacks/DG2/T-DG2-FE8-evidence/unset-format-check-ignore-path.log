# ignore-path variant: the default ignore files (.gitignore, .prettierignore) plus a temporary root ignore file listing the sandbox-masked (EACCES) untracked paths:
.bash_profile
.bashrc
.gitconfig
.gitmodules
.idea
.mcp.json
.profile
.ripgreprc
.vscode
.zprofile
.zshrc
CLAUDE.local.md
$ env -u LANG -u LC_ALL pnpm exec prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .fe8-masked-ignore
Checking formatting...
All matched files use Prettier code style!
exit=0
