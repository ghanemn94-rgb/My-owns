[
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "BUSINESS\nTRANSFORMATION\nPLAYBOOK",
  "id": "B0001"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "A practical system to diagnose, design, mobilize, execute and realize transformation value",
  "id": "B0002"
 },
 {
  "type": "table",
  "rows": [
   [
    "6\nPHASES",
    "15+\nREADY TEMPLATES",
    "1\nOPERATING SYSTEM"
   ]
  ],
  "id": "B0003"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Practical synthesis inspired by PMI Organizational Transformation, Brightline Transformation Compass and PMI Benefits Realization Management; extended with a custom Target Operating Model toolkit.",
  "id": "B0004"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Version 1.0  |  September 2026",
  "id": "B0005"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "HOW TO USE THIS PLAYBOOK",
  "id": "B0006"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "One System, Two Modes",
  "id": "B0007"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Use this playbook in two ways: as a full end-to-end transformation methodology, or as a modular toolkit when you only need a specific deliverable (for example, a Target Operating Model, initiative business case, or benefits register).",
  "id": "B0008"
 },
 {
  "type": "table",
  "rows": [
   [
    "Mode",
    "When to use",
    "How"
   ],
   [
    "End-to-End",
    "New enterprise or business-unit transformation",
    "Run Phases 1-6 sequentially. Do not launch initiatives before the North Star, outcomes and target state are clear."
   ],
   [
    "Modular",
    "A transformation is already underway",
    "Enter at the relevant phase, complete the minimum mandatory templates, then reconnect to outcomes and benefits."
   ]
  ],
  "id": "B0009"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Design principles",
  "id": "B0010"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Outcome before activity: define measurable business outcomes before building a project list.",
  "id": "B0011"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Current state before solution: diagnose economics, customer, operations, capability and technology before prescribing initiatives.",
  "id": "B0012"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Operating model before execution: make decision rights, ownership and cross-functional ways of working explicit.",
  "id": "B0013"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Benefits before closure: an initiative is not complete when delivered; it is complete when value is realized and sustained.",
  "id": "B0014"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "One source of truth: keep the transformation charter, roadmap, initiative portfolio and benefits register linked.",
  "id": "B0015"
 },
 {
  "type": "table",
  "rows": [
   [
    "Rule of thumb  Every transformation deliverable should answer one of four questions: Why change? What must become different? How will we execute? How will we prove value?"
   ]
  ],
  "id": "B0016"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Minimum governance roles",
  "id": "B0017"
 },
 {
  "type": "table",
  "rows": [
   [
    "Role",
    "Accountability"
   ],
   [
    "Executive Sponsor",
    "Owns enterprise outcome, removes constraints, approves major trade-offs."
   ],
   [
    "Transformation Lead",
    "Integrates workstreams, drives cadence, ensures outcome realization."
   ],
   [
    "Business Owners",
    "Own target-state capabilities and BAU adoption."
   ],
   [
    "Workstream Leads",
    "Deliver initiatives and manage dependencies."
   ],
   [
    "Finance / Value Office",
    "Validates baseline, benefit logic, value realization."
   ],
   [
    "Transformation Office",
    "Governance, reporting, risks, dependencies, decisions, standards."
   ]
  ],
  "id": "B0018"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "METHODOLOGY",
  "id": "B0019"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "The 6-Phase Transformation System",
  "id": "B0020"
 },
 {
  "type": "table",
  "rows": [
   [
    "1",
    "DIAGNOSE",
    "Establish fact base",
    "Current state, root causes, value pools"
   ],
   [
    "2",
    "DEFINE",
    "Set direction",
    "North Star, outcomes, KPIs, guardrails"
   ],
   [
    "3",
    "DESIGN",
    "Create target state",
    "Target Operating Model, capabilities, journeys"
   ],
   [
    "4",
    "MOBILIZE",
    "Build execution portfolio",
    "Initiatives, business cases, roadmap, resourcing"
   ],
   [
    "5",
    "TRANSFORM",
    "Execute & govern",
    "Operating system, workstreams, decisions, adoption"
   ],
   [
    "6",
    "REALIZE",
    "Prove & sustain value",
    "Benefits, BAU handover, continuous improvement"
   ]
  ],
  "id": "B0021"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Stage gates",
  "id": "B0022"
 },
 {
  "type": "table",
  "rows": [
   [
    "Gate",
    "Decision question",
    "Evidence required"
   ],
   [
    "G1 - Case for Change",
    "Do we agree on the problem/opportunity and value at stake?",
    "Diagnostic, baseline, root causes, value pools."
   ],
   [
    "G2 - Direction",
    "Are outcomes specific enough to steer decisions?",
    "North Star, outcome tree, KPI definitions, guardrails."
   ],
   [
    "G3 - Target State",
    "Do we know what must be different operationally?",
    "Target Operating Model, capability gaps, future journeys."
   ],
   [
    "G4 - Mobilization",
    "Is the portfolio executable and value-backed?",
    "Initiative cards, business cases, roadmap, owners, capacity."
   ],
   [
    "G5 - Scale",
    "Are pilots/results sufficient to scale?",
    "Performance evidence, adoption, risk closure, decision log."
   ],
   [
    "G6 - Sustain",
    "Is value embedded in BAU?",
    "Benefits evidence, ownership transfer, controls, continuous improvement backlog."
   ]
  ],
  "id": "B0023"
 },
 {
  "type": "table",
  "rows": [
   [
    "PMI/Brightline connection  The playbook uses the people-centered transformation logic and transformation operating-system thinking associated with PMI/Brightline, while adding a more explicit Target Operating Model and management-consulting-style diagnostic/design layer."
   ]
  ],
  "id": "B0024"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "PHASE 1",
  "id": "B0025"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "01  DIAGNOSE — Build the Fact Base",
  "id": "B0026"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Objective: create a shared, evidence-based view of current performance, root causes and value at stake before solutions are chosen.",
  "id": "B0027"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Core work",
  "id": "B0028"
 },
 {
  "type": "table",
  "rows": [
   [
    "Workstream",
    "Key questions",
    "Typical outputs"
   ],
   [
    "Business & Financial",
    "Where is value created/lost? Revenue, margin, cost, churn, productivity?",
    "Baseline P&L bridge, value pools, trend analysis."
   ],
   [
    "Customer",
    "Where does the customer experience break?",
    "Journey pain points, complaints, NPS/CSAT drivers."
   ],
   [
    "Process & Operations",
    "Where are delays, rework, bottlenecks, handoffs?",
    "Process map, cycle time, failure demand."
   ],
   [
    "Organization & Governance",
    "Are roles, decision rights, incentives and accountability clear?",
    "RACI gaps, decision latency, governance map."
   ],
   [
    "Technology & Data",
    "What systems/data constrain performance?",
    "Architecture pain points, automation/data gaps."
   ],
   [
    "Capability",
    "What skills/capabilities are missing?",
    "Capability heatmap, build/buy/partner needs."
   ]
  ],
  "id": "B0029"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Template 1 — Current-State Diagnostic",
  "id": "B0030"
 },
