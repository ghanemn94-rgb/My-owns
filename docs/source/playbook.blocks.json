 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "LAUNCH PLAN",
  "id": "B0132"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "First 90 Days of a New Transformation",
  "id": "B0133"
 },
 {
  "type": "table",
  "rows": [
   [
    "Window",
    "Primary objective",
    "Actions",
    "Outputs"
   ],
   [
    "Days 0-30",
    "Diagnose & align",
    "Confirm sponsor; build baseline; interview stakeholders; map journeys/processes; quantify value pools; establish initial governance.",
    "Charter v0.9; diagnostic; baseline; issue tree; governance."
   ],
   [
    "Days 31-60",
    "Define & design",
    "Agree North Star/outcomes; build KPI tree; design TOM; run design decisions; identify initiatives; size benefits.",
    "North Star; KPI tree; TOM; initiative backlog; initial business case."
   ],
   [
    "Days 61-90",
    "Mobilize & prove",
    "Prioritize portfolio; assign owners; sequence roadmap; launch Wave 1 pilots; establish benefits register and executive dashboard.",
    "Roadmap; initiative cards; dashboard; benefits register; Wave 1 evidence."
   ]
