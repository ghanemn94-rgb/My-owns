  "id": "B0050"
 },
 {
  "type": "table",
  "rows": [
   [
    "Good outcome test  Specific, measurable, strategically relevant, owned by a business leader, and achievable through a defined causal chain—not just “launch”, “implement” or “deliver”."
   ]
  ],
  "id": "B0051"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "PHASE 3",
  "id": "B0052"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "03  DESIGN — Target Operating Model",
  "id": "B0053"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Objective: define what must be different in the business—beyond projects—so the outcomes can be sustained.",
  "id": "B0054"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "The 10-dimension Target Operating Model",
  "id": "B0055"
 },
 {
  "type": "table",
  "rows": [
   [
    "Dimension",
    "Design question"
   ],
   [
    "1. Customer & Value Proposition",
    "What experience/value should customers receive?"
   ],
   [
    "2. Products & Services",
    "What portfolio, pricing, features and service model are required?"
   ],
   [
    "3. Journeys & Processes",
    "What end-to-end journeys/processes must change?"
   ],
   [
    "4. Organization",
    "What structure, roles and accountabilities are needed?"
   ],
   [
    "5. Governance & Decision Rights",
    "Who decides what, at what level, using what forums?"
   ],
   [
    "6. People & Capabilities",
    "What skills, capacity, behaviors and incentives are required?"
   ],
   [
    "7. Technology",
    "What platforms, systems and integration are required?"
   ],
   [
    "8. Data & Analytics",
    "What data, metrics, models and ownership are needed?"
   ],
   [
    "9. Partners & Sourcing",
    "What should be built, bought, outsourced or partnered?"
   ],
   [
    "10. Performance Management",
    "How will KPIs, benefits and continuous improvement be managed?"
   ]
  ],
  "id": "B0056"
 },
