  "type": "para",
  "level": 0,
  "style": "",
  "text": "06  REALIZE — Benefits & Sustainability",
  "id": "B0118"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Objective: convert delivered capabilities into validated business value, transfer ownership to BAU, and establish a mechanism for sustained performance.",
  "id": "B0119"
 },
