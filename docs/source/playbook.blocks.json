  "id": "B0031"
 },
 {
  "type": "table",
  "rows": [
   [
    "Gate 1  Do not proceed with a list of projects. Proceed only when the leadership team agrees on the problem, baseline and material value pools."
   ]
  ],
  "id": "B0032"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "TEMPLATE",
  "id": "B0033"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Transformation Charter",
  "id": "B0034"
 },
