 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "PHASE 5",
  "id": "B0103"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "People, Adoption & Change",
  "id": "B0104"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Transformation fails when the solution is delivered but the organization does not adopt the new way of working. Manage adoption as an outcome with measurable leading indicators.",
  "id": "B0105"
 },
