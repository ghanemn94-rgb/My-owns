  "style": "",
  "text": "Example — International Roaming Transformation",
  "id": "B0143"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Illustrative example only. Replace assumptions with validated company data.",
  "id": "B0144"
 },
 {
  "type": "table",
  "rows": [
