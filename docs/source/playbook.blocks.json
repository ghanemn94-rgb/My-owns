 {
  "type": "table",
  "rows": [
   [
    "Design principle  A project portfolio is not a Target Operating Model. The TOM describes how the business will operate after the transformation; initiatives are the vehicles used to get there."
   ]
  ],
  "id": "B0059"
 },
