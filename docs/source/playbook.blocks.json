  "id": "B0134"
 },
 {
  "type": "para",
  "level": 0,
  "style": "",
  "text": "Day-90 leadership test",
  "id": "B0135"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Can leaders explain the same case for change and North Star?",
  "id": "B0136"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Can every initiative be traced to a target-state gap and outcome?",
  "id": "B0137"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Are executive decision rights clear?",
  "id": "B0138"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Is Finance aligned on baselines and benefit formulas?",
  "id": "B0139"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Are Wave 1 initiatives producing evidence rather than only plans?",
  "id": "B0140"
 },
 {
  "type": "para",
  "level": 0,
  "style": "List Bullet",
  "text": "Can the transformation team show what it needs from executives this month?",
  "id": "B0141"
