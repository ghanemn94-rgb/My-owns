# Mobily Transformation Hub: environment template (GENERATED; do not edit by hand).
# Source: packages/config/src/index.ts ENV_VARS. Regenerate: node deploy/scripts/generate-env-example.mjs
#
# NAMES ONLY. This file never contains values; secrets are runtime configuration outside the repository
# (environment, or a file mounted at runtime and named by <NAME>_FILE, e.g. DATABASE_URL_FILE=/run/secrets/db_url).
# Setting both NAME and NAME_FILE is refused at startup. Invalid configuration exits 78 and names the variable.
# Unset optional variables take the default shown. Compose users: see deploy/compose/ and docs/operations/.

# production | development | test
# required | used by: api, worker, db-cli
NODE_ENV=

# Public origin of the app, e.g. https://hub.example.internal (cookies, OIDC redirect)
# required | used by: api
APP_BASE_URL=

# API listen port
# optional | default: 3000 | used by: api
PORT=

# PostgreSQL URL for the app role (mth_app)
# required | SECRET (prefer DATABASE_URL_FILE) | used by: api, worker
DATABASE_URL=

# PostgreSQL URL for the owner role (migrations, pg-boss schema install)
# required | SECRET (prefer DATABASE_OWNER_URL_FILE) | used by: db-cli
DATABASE_OWNER_URL=

# oidc | dev. `dev` enables local dev login and is refused when NODE_ENV=production
# required | default: oidc | used by: api
AUTH_MODE=

# OIDC issuer (corporate IdP; Keycloak realm URL in tests)
# optional | used by: api
OIDC_ISSUER_URL=

# OIDC client id
# optional | used by: api
OIDC_CLIENT_ID=

# OIDC client secret (confidential client)
# optional | SECRET (prefer OIDC_CLIENT_SECRET_FILE) | used by: api
OIDC_CLIENT_SECRET=

# Requested scopes
# optional | default: openid profile email | used by: api
OIDC_SCOPES=

# Idle session timeout
# optional | default: 30 | used by: api
SESSION_IDLE_MINUTES=

# Absolute session lifetime
# optional | default: 10 | used by: api
SESSION_ABSOLUTE_HOURS=

# filesystem (P1/P2) | s3 (optional, IT-approved, P6)
# optional | default: filesystem | used by: api, worker
EVIDENCE_STORAGE_DRIVER=

# Private directory for the filesystem adapter (not web-served)
# optional | default: /var/lib/mth/evidence | used by: api, worker
EVIDENCE_STORAGE_PATH=

# Configurable product name (REQ-S01-002)
# optional | default: Mobily Transformation Hub | used by: api
PRODUCT_NAME=

# IANA timezone for new organizations
# optional | default: Asia/Riyadh | used by: api, worker
DEFAULT_TIMEZONE=

# ISO 4217 currency for new organizations
# optional | default: SAR | used by: api
DEFAULT_CURRENCY=

# General API requests per minute per session/IP
# optional | default: 300 | used by: api
RATE_LIMIT_PER_MINUTE=

# Login/callback/dev-login requests per minute per IP
# optional | default: 20 | used by: api
AUTH_RATE_LIMIT_PER_MINUTE=

# Evidence and import uploads per minute per session/IP (rate-limit class upload; ADR-0052 §4)
# optional | default: 30 | used by: api
UPLOAD_RATE_LIMIT_PER_MINUTE=

# Global search requests per minute per session/IP (rate-limit class search; ADR-0052 §4)
# optional | default: 120 | used by: api
SEARCH_RATE_LIMIT_PER_MINUTE=

# Assistant messages per minute per session/IP (rate-limit class assistant; ADR-0052 §4)
# optional | default: 20 | used by: api
ASSISTANT_RATE_LIMIT_PER_MINUTE=

# Webhook deliveries per minute per endpoint key (rate-limit class webhook; ADR-0052 §4)
# optional | default: 600 | used by: api
WEBHOOK_RATE_LIMIT_PER_MINUTE=

# Export starts per minute per session/IP (rate-limit class export; ADR-0052 §4)
# optional | default: 10 | used by: api
EXPORT_RATE_LIMIT_PER_MINUTE=

# Directory of secret files read by the built-in file SecretProvider (one file per secret name, e.g. a container secret mount). Optional; unset means the file provider is not configured
# optional | used by: api, worker
SECRETS_DIR=

# fatal | error | warn | info | debug
# optional | default: info | used by: api, worker
LOG_LEVEL=

# Worker pg-boss supervision cadence in seconds: expiry of jobs held by a dead worker, queue monitoring and maintenance (F-DG4-128). Integer 1-600; 60 is the cadence pg-boss documents
# optional | default: 60 | used by: worker
WORKER_SUPERVISE_INTERVAL_SECONDS=

# Seconds between two worker_heartbeat beats of a worker process (ADR-0053 §6). Integer 1-30: the API reports a worker stale when its newest beat is older than 90 s (three default intervals)
# optional | default: 30 | used by: worker
WORKER_HEARTBEAT_SECONDS=

# production | demo | development | test | load: the deployment's environment. Default: production when NODE_ENV=production, else the NODE_ENV value. A demo deployment sets demo explicitly; mth-db seed-demo is refused when it is production, and mth-db reset-demo needs demo. load (ADR-0058 §4) is the synthetic load run only: it needs NODE_ENV=production and AUTH_MODE=oidc and a database generated by deploy/load/generate.mjs
# optional | used by: api, worker, db-cli
MTH_ENV=

# Demo deployments only: PostgreSQL URL of a role with CREATEDB that may drop and re-create the demo database (mth-db reset-demo and the worker's demo.reset job). The API reads only whether it is set (resetConfigured)
# optional | SECRET (prefer MTH_DEMO_ADMIN_DATABASE_URL_FILE) | used by: api, worker, db-cli
MTH_DEMO_ADMIN_DATABASE_URL=

# Comma-separated reverse-proxy addresses whose X-Forwarded-* headers are trusted
# optional | default: (empty) | used by: api
TRUST_PROXY=
