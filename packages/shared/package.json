{
  "name": "@mth/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared constants, permission catalogue, problem types and zod API schemas (ADR-0002)",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "@mth/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "@mth/source": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./calc": {
      "@mth/source": "./src/calc.ts",
      "types": "./dist/calc.d.ts",
      "default": "./dist/calc.js"
    },
    "./time": {
      "@mth/source": "./src/time/index.ts",
      "types": "./dist/time/index.d.ts",
      "default": "./dist/time/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "zod": "4.1.12"
  },
  "devDependencies": {}
}
