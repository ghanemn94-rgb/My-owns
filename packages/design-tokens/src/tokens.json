{
  "$comment": "Single design-token source (ADR-0009). PROVISIONAL values from master prompt §15 (REQ-S15-002). They are NOT verified or official Mobily colours; #0078FF is a provisional brand token. Replace only through the Branding Settings flow (REQ-S15-004) once official values are supplied.",
  "provisional": true,
  "color": {
    "brand.primary": { "value": "#0078FF", "purpose": "Primary accents and selected elements", "provisional": true },
    "brand.deep": { "value": "#003B73", "purpose": "Stronger blue surfaces and text where suitable", "provisional": true },
    "surface.page": { "value": "#F5F8FC", "purpose": "Page background", "provisional": true },
    "surface.card": { "value": "#FFFFFF", "purpose": "Content surfaces", "provisional": true },
    "text.primary": { "value": "#142438", "purpose": "Main text", "provisional": true },
    "text.secondary": { "value": "#526174", "purpose": "Secondary text", "provisional": true },
    "border.default": { "value": "#DCE5EF", "purpose": "Dividers and field boundaries", "provisional": true }
  },
  "derived": {
    "$comment": "Derived from the seeded tokens by a rule (REQ-S15-003). `value` is the result of the rule and a test re-derives it, so a change to a seed without regenerating fails. #0078FF itself is NOT used behind small white text.",
    "action.primary": { "value": "#006DE9", "purpose": "Action buttons (white text), links and focus ring: the lightest shade of brand.primary with >= 4.5:1 against surface.card and surface.page", "derivedFrom": "brand.primary", "rule": {"darkenUntil": 4.5, "against": ["surface.card", "surface.page"]}, "provisional": true },
    "action.primary-hover": { "value": "#0055B6", "purpose": "Hover/pressed state of action buttons", "derivedFrom": "brand.primary", "rule": {"darkenUntil": 7, "against": ["surface.card"]}, "provisional": true }
  },
  "semantic": {
    "$comment": "Semantic tokens (ADR-0009 §3). `ref` entries follow another token at runtime (emitted as var(--mth-…)), so Branding Settings overrides propagate. Status colours are separate from brand blue, never imply a favourable status by blue, and are always shown with a text label and an icon.",
    "text.inverse": { "value": "#FFFFFF", "purpose": "Text on dark/blue surfaces", "provisional": true },
    "border.control": { "value": "#7A8699", "purpose": "Form control and table boundaries (>= 3:1 non-text contrast; border.default is decorative only)", "provisional": true },
    "focus.ring": { "ref": "action.primary", "purpose": "Visible keyboard focus indicator", "provisional": true },
    "nav.background": { "ref": "brand.deep", "purpose": "Blue primary navigation", "provisional": true },
    "nav.text": { "value": "#FFFFFF", "purpose": "Navigation text", "provisional": true },
    "nav.text-muted": { "value": "#C9D8EA", "purpose": "Secondary navigation text (section labels, planned-stage hints)", "provisional": true },
    "nav.selected-background": { "ref": "surface.card", "purpose": "Selected navigation item (plus a bar and aria-current, not colour alone)", "provisional": true },
    "nav.selected-text": { "ref": "brand.deep", "purpose": "Selected navigation item text", "provisional": true },
    "header.gradient-start": { "ref": "brand.deep", "purpose": "Restrained blue-gradient header, start", "provisional": true },
    "header.gradient-end": { "value": "#0A4F96", "purpose": "Restrained blue-gradient header, end", "provisional": true },
    "surface.selected": { "value": "#E8F1FC", "purpose": "Selected rows and chips on light surfaces", "provisional": true },
    "status.on-track.fg": { "value": "#1A6B3C", "purpose": "Status On track: text/icon (green, never blue)", "provisional": true },
    "status.on-track.bg": { "value": "#E6F4EA", "purpose": "Status On track: chip background", "provisional": true },
    "status.at-risk.fg": { "value": "#7A4B00", "purpose": "Status At risk: text/icon", "provisional": true },
    "status.at-risk.bg": { "value": "#FFF1D6", "purpose": "Status At risk: chip background", "provisional": true },
    "status.off-track.fg": { "value": "#A11B1B", "purpose": "Status Off track: text/icon", "provisional": true },
    "status.off-track.bg": { "value": "#FDECEC", "purpose": "Status Off track: chip background", "provisional": true },
    "status.unknown.fg": { "value": "#4A5565", "purpose": "Status Unknown (missing data): text/icon; never green or zero", "provisional": true },
    "status.unknown.bg": { "value": "#EDF0F4", "purpose": "Status Unknown: chip background", "provisional": true },
    "status.stale.fg": { "value": "#5A3E8C", "purpose": "Status Stale (data older than its refresh rule): text/icon", "provisional": true },
    "status.stale.bg": { "value": "#F0EBFA", "purpose": "Status Stale: chip background", "provisional": true },
    "feedback.error.fg": { "value": "#A11B1B", "purpose": "Error messages and invalid fields", "provisional": true },
    "feedback.error.bg": { "value": "#FDECEC", "purpose": "Error banner background", "provisional": true },
    "feedback.warning.fg": { "value": "#7A4B00", "purpose": "Warnings (e.g. conflict, stale data)", "provisional": true },
    "feedback.warning.bg": { "value": "#FFF1D6", "purpose": "Warning banner background", "provisional": true },
    "feedback.success.fg": { "value": "#1A6B3C", "purpose": "Operation succeeded (e.g. saved); not a business status", "provisional": true },
    "feedback.success.bg": { "value": "#E6F4EA", "purpose": "Success banner background", "provisional": true },
    "feedback.info.fg": { "ref": "brand.deep", "purpose": "Neutral information", "provisional": true },
    "feedback.info.bg": { "value": "#E8F1FC", "purpose": "Information banner background", "provisional": true },
    "badge.provisional.fg": { "value": "#7A4B00", "purpose": "Provisional marker (wordmark, tokens)", "provisional": true },
    "badge.provisional.bg": { "value": "#FFF1D6", "purpose": "Provisional marker background", "provisional": true }
  },
  "contrastPairs": {
    "$comment": "Every foreground/background combination the UI uses (REQ-S15-003). `pnpm --filter @mth/design-tokens run check:contrast` fails the build if any pair is below WCAG AA for its use (text 4.5:1; large-text and ui 3:1).",
    "pairs": [
      { "fg": "text.primary", "bg": "surface.page", "use": "text", "where": "body text on the page" },
      { "fg": "text.primary", "bg": "surface.card", "use": "text", "where": "body text on cards, tables, forms" },
      { "fg": "text.secondary", "bg": "surface.page", "use": "text", "where": "secondary text on the page" },
      { "fg": "text.secondary", "bg": "surface.card", "use": "text", "where": "secondary text on cards" },
      { "fg": "brand.deep", "bg": "surface.page", "use": "text", "where": "headings on the page" },
      { "fg": "brand.deep", "bg": "surface.card", "use": "text", "where": "headings on cards" },
      { "fg": "text.inverse", "bg": "action.primary", "use": "text", "where": "primary action button" },
      { "fg": "text.inverse", "bg": "action.primary-hover", "use": "text", "where": "primary action button, hover/pressed" },
      { "fg": "action.primary", "bg": "surface.card", "use": "text", "where": "links and secondary buttons on cards" },
      { "fg": "action.primary", "bg": "surface.page", "use": "text", "where": "links on the page" },
      { "fg": "focus.ring", "bg": "surface.card", "use": "ui", "where": "focus indicator on cards" },
      { "fg": "focus.ring", "bg": "surface.page", "use": "ui", "where": "focus indicator on the page" },
      { "fg": "nav.text", "bg": "nav.background", "use": "ui", "where": "focus indicator inside navigation" },
      { "fg": "border.control", "bg": "surface.card", "use": "ui", "where": "form control boundaries on cards" },
      { "fg": "border.control", "bg": "surface.page", "use": "ui", "where": "form control boundaries on the page" },
      { "fg": "brand.primary", "bg": "surface.card", "use": "ui", "where": "selected-state accents and large headings only (never small text)" },
      { "fg": "brand.primary", "bg": "surface.page", "use": "large-text", "where": "large accent text only" },
      { "fg": "nav.text", "bg": "nav.background", "use": "text", "where": "navigation items" },
      { "fg": "nav.text-muted", "bg": "nav.background", "use": "text", "where": "navigation section labels" },
      { "fg": "nav.selected-text", "bg": "nav.selected-background", "use": "text", "where": "selected navigation item" },
      { "fg": "text.inverse", "bg": "header.gradient-start", "use": "text", "where": "header text, gradient start" },
      { "fg": "text.inverse", "bg": "header.gradient-end", "use": "text", "where": "header text, gradient end" },
      { "fg": "text.primary", "bg": "surface.selected", "use": "text", "where": "selected table row" },
      { "fg": "brand.deep", "bg": "surface.selected", "use": "text", "where": "selected chip" },
      { "fg": "status.on-track.fg", "bg": "status.on-track.bg", "use": "text", "where": "status chip On track" },
      { "fg": "status.at-risk.fg", "bg": "status.at-risk.bg", "use": "text", "where": "status chip At risk" },
      { "fg": "status.off-track.fg", "bg": "status.off-track.bg", "use": "text", "where": "status chip Off track" },
      { "fg": "status.unknown.fg", "bg": "status.unknown.bg", "use": "text", "where": "status chip Unknown" },
      { "fg": "status.stale.fg", "bg": "status.stale.bg", "use": "text", "where": "status chip Stale" },
      { "fg": "status.on-track.fg", "bg": "surface.card", "use": "text", "where": "status icon/label on a card" },
      { "fg": "status.at-risk.fg", "bg": "surface.card", "use": "text", "where": "status icon/label on a card" },
      { "fg": "status.off-track.fg", "bg": "surface.card", "use": "text", "where": "status icon/label on a card" },
      { "fg": "status.unknown.fg", "bg": "surface.card", "use": "text", "where": "status icon/label on a card" },
      { "fg": "status.stale.fg", "bg": "surface.card", "use": "text", "where": "status icon/label on a card" },
      { "fg": "feedback.error.fg", "bg": "feedback.error.bg", "use": "text", "where": "error banner" },
      { "fg": "feedback.error.fg", "bg": "surface.card", "use": "text", "where": "field error message" },
      { "fg": "feedback.warning.fg", "bg": "feedback.warning.bg", "use": "text", "where": "warning/conflict/stale banner" },
      { "fg": "feedback.success.fg", "bg": "feedback.success.bg", "use": "text", "where": "success banner" },
      { "fg": "feedback.info.fg", "bg": "feedback.info.bg", "use": "text", "where": "information banner" },
      { "fg": "badge.provisional.fg", "bg": "badge.provisional.bg", "use": "text", "where": "Provisional badge next to the wordmark" },
      { "fg": "text.primary", "bg": "feedback.warning.bg", "use": "text", "where": "body text inside warning banners" },
      { "fg": "text.primary", "bg": "feedback.error.bg", "use": "text", "where": "body text inside error banners" },
      { "fg": "text.primary", "bg": "feedback.info.bg", "use": "text", "where": "body text inside information banners" },
      { "fg": "text.secondary", "bg": "status.unknown.bg", "use": "text", "where": "secondary text on neutral chips" },
      { "fg": "text.inverse", "bg": "feedback.error.fg", "use": "text", "where": "destructive action button (archive, revoke)" },
      { "fg": "text.inverse", "bg": "brand.deep", "use": "text", "where": "current phase in the phase stepper" },
      { "fg": "text.primary", "bg": "feedback.success.bg", "use": "text", "where": "body text inside success banners" },
      { "fg": "text.secondary", "bg": "surface.selected", "use": "text", "where": "secondary text in selected rows" },
      { "fg": "border.control", "bg": "surface.selected", "use": "ui", "where": "control boundaries inside selected rows" },
      { "fg": "badge.provisional.bg", "bg": "header.gradient-start", "use": "ui", "where": "provisional badge shape against the header" }
    ],
    "prohibited": [
      { "fg": "text.inverse", "bg": "brand.primary", "use": "text", "why": "white small text on #0078FF is about 4.09:1; action buttons use action.primary instead" },
      { "fg": "brand.primary", "bg": "surface.page", "use": "text", "why": "about 3.84:1; body-size links use action.primary" },
      { "fg": "border.default", "bg": "surface.card", "use": "ui", "why": "decorative divider only; control boundaries use border.control" }
    ]
  }
}
