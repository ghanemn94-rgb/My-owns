# Build context filter for deploy/docker/Dockerfile (context = repository root). ADR-0011, T-DG1-DEVOPS.
# Keeps the context small and reproducible, and keeps anything secret, local or unrelated out of every image layer.

# Version control and editor/agent state
.git
.github
.idea
.vscode
.claude
**/.claude
.mcp.json
CLAUDE.md
CLAUDE.local.md
.gitmodules
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.ripgreprc

# Installed and built artefacts: the image installs from the lockfile and builds from source itself
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
test-results
playwright-report
blob-report
apps/web/e2e/screenshots

# Local configuration and secrets (never baked into an image; runtime configuration only)
.env
.env.*
!.env.example
**/.env
deploy/compose/.env
**/*.pem
**/*.key
**/*secret*
# ...but never drop tracked TypeScript SOURCES whose names merely contain "secret" (secrets.ts, secret-refs.ts,
# secret-namespace.ts: code that resolves SecretRefs at runtime, not secret values). Without these the build stage
# fails to compile. deploy/scripts/tests/dockerfile-context.test.mjs fails if any git-tracked file under apps/*/src or
# packages/*/src is excluded from the build context.
!apps/*/src/**/*secret*.ts
!apps/*/src/**/*secret*.tsx
!packages/*/src/**/*secret*.ts
!packages/*/src/**/*secret*.tsx
!packages/config/src/**

# Local evidence storage (filesystem adapter in development)
var

# Not part of the product: delivery process, gate tooling, sources, unrelated user project
docs/delivery
!docs/delivery/requirements.csv
docs/source
tools
trading_agent
**/__pycache__
**/*.py[cod]
