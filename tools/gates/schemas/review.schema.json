{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DG review record",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "round",
    "candidate_id",
    "source_commit",
    "reviewer_role",
    "invocation_reference",
    "implementation_author",
    "independence_declaration",
    "assignment",
    "requirements_checked",
    "checks_run",
    "findings",
    "verdict",
    "evidence_paths",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage_id": {
      "type": "string",
      "pattern": "^DG[0-7]$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewer_role": {
      "enum": [
        "domain-reviewer",
        "code-security-reviewer",
        "qa-verifier",
        "release-auditor"
      ]
    },
    "invocation_reference": {
      "$ref": "#/$defs/invref"
    },
    "implementation_author": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "transformation-analyst",
          "solution-architect",
          "frontend-ux-engineer",
          "backend-workflow-engineer",
          "kpi-benefits-engineer",
          "devops-engineer",
          "domain-reviewer",
          "code-security-reviewer",
          "qa-verifier",
          "release-auditor",
          "delivery-orchestrator"
        ]
      }
    },
    "independence_declaration": {
      "type": "object",
      "required": [
        "reviewer_authored_reviewed_scope",
        "statement"
      ],
      "properties": {
        "reviewer_authored_reviewed_scope": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "string",
      "minLength": 1
    },
    "requirements_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
      }
    },
    "checks_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "narrative": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "invref": {
      "type": "object",
      "required": [
        "kind",
        "run_id",
        "session_id"
      ],
      "properties": {
        "kind": {
          "const": "claude-code-cli-session"
        },
        "run_id": {
          "type": "string",
          "pattern": "^DG[0-7]-[A-Za-z0-9._-]+$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "procedure",
        "environment",
        "expected",
        "actual",
        "exit_status",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string",
          "minLength": 3
        },
        "command": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "exit_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}