{
  "$comment": "Role write scopes for FILE TOOLS, enforced by tools/agents/guard-write.mjs (PreToolUse hook on Write/Edit/NotebookEdit/MultiEdit). Paths are relative to the guarded repository or one of its worktrees; 'deny' wins over 'allow'; deny patterns match case-insensitively; '.git' segments are never writable. Outside the guarded repository and its worktrees only the OS temporary directory is scratch, and the home directory never is (D-024). Shell (Bash) writes are confined separately by the OS sandbox generated by tools/agents/agent_settings.py (D-025). Changing this file is a gate-rule change: it is part of every stage candidate's review scope and implementers cannot edit it.",
  "protected_for_implementers": [
    "tools/gates/**",
    "tools/agents/**",
    "docs/source/**",
    "docs/delivery/reviews/**",
    "docs/delivery/gates/**",
    "docs/delivery/stages.json",
    ".github/workflows/delivery-gates.yml",
    "docs/delivery/runs/**",
    "docs/delivery/findings.json",
    "docs/delivery/candidates/**",
    "docs/delivery/test-evidence/**",
    ".claude/**",
    "**/.claude/**",
    ".mcp.json",
    "**/.mcp.json",
    "CLAUDE.md",
    "**/CLAUDE.md",
    "**/CLAUDE.local.md",
    "CLAUDE.local.md",
    "trading_agent/**"
  ],
  "roles": {
    "transformation-analyst": {
      "allow": [
        "docs/analysis/**",
        "docs/delivery/requirements.csv",
        "docs/delivery/handbacks/**"
      ],
      "deny": [
        "@protected_config"
      ]
    },
    "solution-architect": {
      "allow": [
        "**"
      ],
      "deny": [
        "@protected_for_implementers"
      ]
    },
    "frontend-ux-engineer": {
      "allow": [
        "**"
      ],
      "deny": [
        "@protected_for_implementers"
      ]
    },
    "backend-workflow-engineer": {
      "allow": [
        "**"
      ],
      "deny": [
        "@protected_for_implementers"
      ]
    },
    "kpi-benefits-engineer": {
      "allow": [
        "**"
      ],
      "deny": [
        "@protected_for_implementers"
      ]
    },
    "devops-engineer": {
      "allow": [
        "**"
      ],
      "deny": [
        "@protected_for_implementers"
      ]
    },
    "domain-reviewer": {
      "allow": [
        "docs/delivery/reviews/**",
        "docs/delivery/test-evidence/**"
      ],
      "deny": [
