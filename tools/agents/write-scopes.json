        "docs/delivery/gates/**",
        "docs/delivery/test-evidence/**"
      ],
      "deny": [
        "@protected_config"
      ]
    }
  },
  "protected_config": [
    ".claude/**",
    "**/.claude/**",
    ".mcp.json",
    "**/.mcp.json",
    "CLAUDE.md",
    "**/CLAUDE.md",
